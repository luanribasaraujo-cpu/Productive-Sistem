async function hashPin(pin) { try { if (window.crypto && window.crypto.subtle) { const hashBuffer = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(pin)); return Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, '0')).join(''); } return btoa(pin).split('').reverse().join(''); } catch(e) { return pin; } }

