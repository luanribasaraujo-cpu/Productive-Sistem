window.criarPropriaConta = async function() {
    const iN = document.getElementById('new-self-user-name'), iT = document.getElementById('new-self-user-team'); if(!iN || !iT) return; const n = iN.value.trim(), t = iT.value; if (!n) return showToast("Digite seu nome!", "error");
