// --- LÓGICA DE DATAS ---
function isDateInPeriod(dateStr, period) {
    if (period === 'all') return true;
    
    const parts = dateStr.split('/');
    const actDate = new Date(parts[2], parts[1]-1, parts[0]);
    actDate.setHours(0,0,0,0);
    
    const today = new Date();
    today.setHours(0,0,0,0);
    
    if (period === 'today') return actDate.getTime() === today.getTime();
    
    if (period === 'yesterday') {
        const yesterday = new Date(today);
        yesterday.setDate(today.getDate() - 1);
        return actDate.getTime() === yesterday.getTime();
    }
    
    if (period === 'week') {
        const dayOfWeek = today.getDay(); 
        const startOfWeek = new Date(today);
        startOfWeek.setDate(today.getDate() - dayOfWeek);
        return actDate >= startOfWeek;
    }

    if (period === 'last_week') {
        const dayOfWeek = today.getDay();
        const startOfThisWeek = new Date(today);
        startOfThisWeek.setDate(today.getDate() - dayOfWeek);

        const startOfLastWeek = new Date(startOfThisWeek);
        startOfLastWeek.setDate(startOfThisWeek.getDate() - 7);

        const endOfLastWeek = new Date(startOfThisWeek);
        endOfLastWeek.setDate(startOfThisWeek.getDate() - 1);

        return actDate >= startOfLastWeek && actDate <= endOfLastWeek;
    }
    
    if (period === 'month') {
        return actDate.getMonth() === today.getMonth() && actDate.getFullYear() === today.getFullYear();
    }
    
    return true;
}

// --- GESTÃO DE MEMBROS ---
function renderGrid() {
    const grid = document.getElementById('users-grid');
    const term = document.getElementById('main-search').value.toLowerCase();
    
    const filterEl = document.getElementById('filter-period');
    const filterPeriod = filterEl ? filterEl.value : 'week'; // Inicia na semana por padrão

    grid.innerHTML = '';

    let filtered = users;
    if (currentTab !== 'all') filtered = filtered.filter(u => u.teamId === currentTab);
    if (term) filtered = filtered.filter(u => u.name.toLowerCase().includes(term));

    if (filtered.length === 0) {
        grid.innerHTML = `
            <div class="empty-state">
                <i class="ph-duotone ph-users-slash"></i>
                <h3 style="margin: 0 0 10px 0;">Nenhum membro encontrado</h3>
                <p style="margin: 0; font-size: 0.9rem;">Adicione pessoas usando o botão "Ajustes de Equipe" na barra lateral.</p>
            </div>
        `;
    } else {
        filtered.forEach(u => {
            const uActs = activities.filter(a => a.userId === u.id && isDateInPeriod(a.date, filterPeriod));
            const uQtd = uActs.reduce((acc, c) => acc + Number(c.qtd), 0);
            const uMin = uActs.reduce((acc, c) => acc + timeToMin(c.time), 0);

            const teamName = teams.find(t => t.id === u.teamId)?.name || 'Sem Equipe';

            grid.innerHTML += `
                <div class="card-user" onclick="openUserModal(${u.id})">
                    <div class="team-badge">${teamName}</div>
                    <img src="${u.avatar}" loading="lazy">
                    <h3>${u.name}</h3>
                    <div class="tags" style="margin-top: 15px; display: flex; gap: 10px; border-top: 1px solid var(--border); padding-top: 15px;">
                        <span class="tag" style="font-size: 0.85rem; color: var(--muted); font-weight: 600; flex: 1;"><i class="ph-fill ph-clock" style="color: var(--accent)"></i> ${minToTime(uMin)}</span>
                        <span class="tag" style="font-size: 0.85rem; color: var(--muted); font-weight: 600; flex: 1;"><i class="ph-fill ph-package" style="color: var(--success)"></i> ${uQtd} un.</span>
                    </div>
                </div>
            `;
        });
    }

    document.getElementById('stats-members').innerText = filtered.length;
}

