window.toggleTracker = async function() {
    const ativInput = document.getElementById('tracker-atividade'), descInput = document.getElementById('tracker-descricao'); 
    if(!ativInput || !descInput) return;
    const atividadeId = ativInput.value, descricao = descInput.value, icon = document.getElementById('tracker-icon'), btn = document.getElementById('btn-tracker-play'), textBtn = document.getElementById('tracker-text-btn');
    if (!loggedUserId) return showToast("Sessão expirada. Faça login novamente.", "error");

    if (currentTrackingId) {
        const horaFim = new Date(); let duracao = Math.floor((horaFim - trackerStartTime) / 1000); 
        await supabaseClient.from('apontamentos').update({ fim: horaFim.toISOString(), duracao_segundos: duracao, em_andamento: false }).eq('id', currentTrackingId);
        pararRelogioVisual(); currentTrackingId = null; trackerStartTime = null;
        
        const display = document.getElementById('tracker-display'); if(display) display.innerText = "00:00:00"; 
        if(icon) icon.classList.replace('ph-stop', 'ph-play'); if(btn) btn.style.background = 'var(--success)'; if(textBtn) textBtn.innerText = "Iniciar";
        
        // Reset Dropdowns
        if(descInput) descInput.value = "";
        const descDisplay = document.getElementById('display-tarefa'); if(descDisplay) { descDisplay.innerText = "Selecione uma tarefa..."; descDisplay.style.color = 'var(--text)'; }
        if(ativInput) ativInput.value = "";
        const ativDisplay = document.getElementById('display-atividade'); if(ativDisplay) { ativDisplay.innerText = "Nenhuma..."; ativDisplay.style.color = 'var(--accent)'; }
        
        showToast("Tempo registado!"); refreshActiveHistories();
    } else {
        trackerStartTime = new Date();
        const { data, error } = await supabaseClient.from('apontamentos').insert([{ usuario_id: loggedUserId, atividade_id: atividadeId ? atividadeId : null, descricao: descricao || "Sem descrição", inicio: trackerStartTime.toISOString(), em_andamento: true }]).select();
        if (!error && data) { currentTrackingId = data[0].id; iniciarRelogioVisual(); refreshActiveHistories(); } else { showToast("Erro ao iniciar temporizador.", "error"); }
    }
}

function iniciarRelogioVisual() {
    const icon = document.getElementById('tracker-icon'), btn = document.getElementById('btn-tracker-play'), textBtn = document.getElementById('tracker-text-btn'), display = document.getElementById('tracker-display');
    if(icon) icon.classList.replace('ph-play', 'ph-stop'); if(btn) btn.style.background = 'var(--danger)'; if(textBtn) textBtn.innerText = "Parar";
    trackerInterval = setInterval(() => {
        let diferencaMs = new Date() - trackerStartTime; const h = String(Math.floor(diferencaMs / 3600000)).padStart(2, '0'), m = String(Math.floor((diferencaMs % 3600000) / 60000)).padStart(2, '0'), s = String(Math.floor((diferencaMs % 60000) / 1000)).padStart(2, '0');
        const timeStr = `${h}:${m}:${s}`; if(display) display.innerText = timeStr; document.title = `⏳ ${timeStr} | Prod Manager`;
    }, 1000);
}

function pararRelogioVisual() { clearInterval(trackerInterval); document.title = "Sistema de Produção Pro - Equipes"; }

async function carregarHistoricoLivreSupabase(userId, listContainerId = 'm-historico-livre', dateFilterId = null) {
    const list = document.getElementById(listContainerId); if(!list) return; 
    if (!list.innerHTML || list.innerHTML.trim() === '') list.innerHTML = SKELETON_HTML;
    
    let targetDate = new Date();
    const dFilter = document.getElementById(dateFilterId);
    if (dFilter && dFilter.value) {
        const [y, m, d] = dFilter.value.split('-');
        targetDate = new Date(y, m-1, d);
    }
    
    const startOfDay = new Date(targetDate); startOfDay.setHours(0,0,0,0);
    const endOfDay = new Date(targetDate); endOfDay.setHours(23,59,59,999);

    const { data: dbAtivs } = await supabaseClient.from('atividades').select('*');
    const atividadesList = dbAtivs || [];

    let res = await supabaseClient.from('apontamentos').select('*').eq('usuario_id', String(userId)).gte('inicio', startOfDay.toISOString()).lte('inicio', endOfDay.toISOString()).order('inicio', { ascending: false });
    if (!res.data || res.data.length === 0) { res = await supabaseClient.from('apontamentos').select('*').eq('usuario_id', Number(userId)).gte('inicio', startOfDay.toISOString()).lte('inicio', endOfDay.toISOString()).order('inicio', { ascending: false }); }
    if (!res.data || res.data.length === 0) { res = await supabaseClient.from('apontamentos').select('*').eq('usuario_id', userId).gte('inicio', startOfDay.toISOString()).lte('inicio', endOfDay.toISOString()).order('inicio', { ascending: false }); }

    let fetchedData = res.data || [];

    if (fetchedData.length === 0) { 
        list.innerHTML = `<div style="color: var(--muted); padding: 15px; border: 1px dashed var(--border); border-radius: 8px; text-align: center;">Nenhum tempo guardado neste dia.</div>`; 
        return; 
    }

    const meses = ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun", "Jul", "Ago", "Set", "Out", "Nov", "Dez"];
    const agora = new Date();
    let dataStr = "";
    
    if (targetDate.getDate() === agora.getDate() && targetDate.getMonth() === agora.getMonth() && targetDate.getFullYear() === agora.getFullYear()) {
        dataStr = "Hoje, " + String(targetDate.getDate()).padStart(2, '0') + " de " + meses[targetDate.getMonth()];
    } else {
        dataStr = String(targetDate.getDate()).padStart(2, '0') + " de " + meses[targetDate.getMonth()];
    }

    let html = `<div class="history-group-header">${dataStr}</div>`;
    html += fetchedData.map(ap => {
        const isRunning = ap.em_andamento, color = colorPalette[(ap.atividade_id || 0) % colorPalette.length];
        let duracaoStr = '';
        if (isRunning) { duracaoStr = `<span style="color: var(--success); font-size: 0.8rem;"><i class="ph ph-spinner-gap ph-spin"></i> A rodar</span>`; } 
        else if (ap.duracao_segundos !== null) { const h = String(Math.floor(ap.duracao_segundos / 3600)).padStart(2, '0'), m = String(Math.floor((ap.duracao_segundos % 3600) / 60)).padStart(2, '0'); duracaoStr = `${h}h ${m}m`; }

        const horaInicio = new Date(ap.inicio).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }), horaFim = (ap.fim && !isRunning) ? new Date(ap.fim).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) : '--:--';
        const textoDescricao = ap.descricao || 'Sem descrição';
        const nomeCategoria = atividadesList.find(x => String(x.id) === String(ap.atividade_id))?.nome || 'Nenhuma categoria';
        let playBtn = isRunning ? "" : `<button class="btn-play-history" onclick="retomarTarefa('${ap.atividade_id || ''}', '${ap.descricao || ''}')" data-tooltip="Retomar esta tarefa"><i class="ph-fill ph-play"></i></button>`;
        let statusClass = isRunning ? "active" : "";

        return `
        <div class="history-row ${statusClass}">
            <div class="history-main">
                <span class="color-dot" style="background: ${color};"></span>
                <div class="history-text">
                    <strong>${textoDescricao}</strong>
                    <small>${nomeCategoria}</small>
                </div>
            </div>
            <div class="history-meta" style="display: flex; gap: 5px; align-items: center;">
                <input type="time" class="inline-time-edit" value="${horaInicio}" onchange="salvarEdicaoInline(${ap.id}, '${ap.inicio}', 'inicio', this.value)" data-tooltip="Editar Início">
                <span style="color: var(--muted); margin: 0 2px;">-</span>
                <input type="time" class="inline-time-edit" value="${horaFim}" onchange="salvarEdicaoInline(${ap.id}, '${ap.inicio}', 'fim', this.value)" data-tooltip="Editar Fim" ${isRunning ? 'disabled' : ''}>
                
                <span class="history-duration" style="margin-left: 15px;">${duracaoStr}</span>
                
                <div style="display: flex; gap: 5px; margin-left: 10px;">
                    ${playBtn}
                    <button class="btn-play-history" style="color: var(--danger);" onclick="deletarApontamentoTempo(${ap.id})" data-tooltip="Eliminar registo"><i class="ph-bold ph-trash"></i></button>
                </div>
            </div>
        </div>`;
    }).join('');
    
    list.innerHTML = html; aplicarTooltips();
}

window.salvarEdicaoInline = async function(id, baseIso, field, newTimeStr) {
    if(!newTimeStr || newTimeStr === '--:--') return; 
    const [h, m] = newTimeStr.split(':').map(Number); if(isNaN(h) || isNaN(m)) return;
    
    const baseDate = new Date(baseIso);
    const { data } = await supabaseClient.from('apontamentos').select('*').eq('id', id).single();
    
    if(data) {
        let nI = new Date(data.inicio), nF = data.fim ? new Date(data.fim) : null;
        
        if (field === 'inicio') { 
            let suggestedNewDate = new Date(baseDate); 
            suggestedNewDate.setHours(h, m, 0, 0); 
            
            const now = new Date();
            if (baseDate.getDate() === now.getDate() && baseDate.getMonth() === now.getMonth() && baseDate.getFullYear() === now.getFullYear()) {
                if (suggestedNewDate > now) {
                    showToast("Não pode registar horas no futuro.", "error"); refreshActiveHistories(); return;
                }
            }
            nI = suggestedNewDate; 
        } else if (field === 'fim') { 
            let suggestedNewDate = new Date(baseDate); 
            suggestedNewDate.setHours(h, m, 0, 0);
            
            const now = new Date();
            if (baseDate.getDate() === now.getDate() && baseDate.getMonth() === now.getMonth() && baseDate.getFullYear() === now.getFullYear()) {
                if (suggestedNewDate > now) {
                    showToast("Não pode definir um fim no futuro.", "error"); refreshActiveHistories(); return;
                }
            }
            nF = suggestedNewDate; 
        }
        
        if (nF && nF < nI && field === 'fim') nF.setDate(nF.getDate() + 1); if (nF && nF < nI && field === 'inicio') nI.setDate(nI.getDate() - 1);
        let dur = null; if (nF && !data.em_andamento) dur = Math.floor((nF - nI) / 1000);
        
        const upd = { inicio: nI.toISOString() }; if (nF) upd.fim = nF.toISOString(); if (dur !== null) upd.duracao_segundos = dur;
        await supabaseClient.from('apontamentos').update(upd).eq('id', id);
        
        showToast("Horário ajustado!", "success"); refreshActiveHistories();
        if (currentTrackingId == id && field === 'inicio') { trackerStartTime = nI; }
    }
}

