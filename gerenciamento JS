            </button>
        </div>
    `}).join('');
}

function delUser(id, userName) {
    abrirConfirm("Excluir Membro", `Tem certeza que deseja remover permanentemente o(a) membro "${userName}"? Os registros antigos serão mantidos no banco de dados local para auditoria.`, async () => {
        // Apaga da nuvem
        const { error } = await supabaseClient.from('users').delete().eq('id', id);
        if (error) return showToast("Erro ao excluir membro.", "error");

        users = users.filter(u => u.id !== id);
        renderGrid();
        renderAdminUsers();
        showToast("Membro removido com sucesso!");
    });
}

function toggleTheme() {
    const body = document.body;
    const themeIcon = document.getElementById('theme-icon');
    
    body.classList.toggle('dark-mode');
    
    if (body.classList.contains('dark-mode')) {
        themeIcon.classList.remove('ph-moon');
        themeIcon.classList.add('ph-sun');
        localStorage.setItem('theme', 'dark');
    } else {
        themeIcon.classList.remove('ph-sun');
        themeIcon.classList.add('ph-moon');
        localStorage.setItem('theme', 'light');
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const savedTheme = localStorage.getItem('theme');
    const themeIcon = document.getElementById('theme-icon');
    
    if (savedTheme === 'dark') {
        document.body.classList.add('dark-mode');
        if (themeIcon) {
            themeIcon.classList.remove('ph-moon');
            themeIcon.classList.add('ph-sun');
        }
    }
});

