function switchView(view) {
    const gridContainer = document.getElementById('view-grid-container');
    const chartsContainer = document.getElementById('view-charts-container');
    const btnGrid = document.getElementById('btn-view-grid');
    const btnCharts = document.getElementById('btn-view-charts');

    if (view === 'grid') {
        gridContainer.classList.remove('hidden');
        chartsContainer.classList.add('hidden');
        
        btnGrid.classList.remove('outline');
        btnGrid.style.border = 'none';
        
        btnCharts.classList.add('outline');
        btnCharts.style.border = 'none';
    } else {
        gridContainer.classList.add('hidden');
        chartsContainer.classList.remove('hidden');
        
        btnCharts.classList.remove('outline');
        btnCharts.style.border = 'none';
        
        btnGrid.classList.add('outline');
        btnGrid.style.border = 'none';
        
        renderCharts();
    }
}

function limparFiltroData() {
    document.getElementById('chart-date-start').value = '';
    document.getElementById('chart-date-end').value = '';
    document.getElementById('chart-search').value = ''; 
    renderCharts();
    showToast("Filtros limpos!");
}

function renderCharts() {
    // 1. Destruir gráficos anteriores
    chartInstances.forEach(chart => chart.destroy());
    chartInstances = [];

    const mode = document.getElementById('chart-mode').value;
    const startInput = document.getElementById('chart-date-start').value;
    const endInput = document.getElementById('chart-date-end').value;
    const searchTerm = document.getElementById('chart-search').value.toLowerCase();

    // 2. Localizar e preparar o container que receberá os gráficos
    let chartContainer = document.getElementById('multi-charts-container');
    if (!chartContainer) {
        // Usa o pai do canvas original como container dinâmico
        const originalCanvas = document.getElementById('teamChart');
        if (originalCanvas) {
            chartContainer = originalCanvas.parentElement;
            chartContainer.id = 'multi-charts-container'; 
        }
    }
    if (!chartContainer) return;
    
    // Limpa o container para recriar
    chartContainer.innerHTML = ''; 
    chartContainer.style.display = 'grid';
    chartContainer.style.gridTemplateColumns = 'repeat(auto-fill, minmax(400px, 1fr))';
    chartContainer.style.gap = '20px';

    // 3. Filtrar Atividades
    let filteredActs = activities;
    
    let startTs = 0;
    let endTs = Infinity;
    
    if (startInput) {
        // Quebra a data 'YYYY-MM-DD' em números para evitar conflitos de fuso/navegador
        const [y, m, d] = startInput.split('-').map(Number);
        startTs = new Date(y, m - 1, d, 0, 0, 0).getTime();
    }
    
    if (endInput) {
        const [y, m, d] = endInput.split('-').map(Number);
        endTs = new Date(y, m - 1, d, 23, 59, 59, 999).getTime();
    }

    if (startInput || endInput) {
        // Filtra comparando o timestamp exato do momento em que foi salvo (a.id) com o período
        filteredActs = activities.filter(a => a.id >= startTs && a.id <= endTs);
    }

    // Ordena as atividades de forma cronológica (do mais antigo pro mais novo)
    filteredActs.sort((a, b) => a.id - b.id);

    // Identifica Entidades (Equipes ou Usuários) que devem ter um gráfico
    let entitiesToRender = [];

    if (mode === 'teams') {
        let displayTeams = teams.filter(t => t.id !== 'all');
        if (searchTerm) displayTeams = displayTeams.filter(t => t.name.toLowerCase().includes(searchTerm));
        
        displayTeams.forEach(t => {
            const tUsers = users.filter(u => u.teamId === t.id);
            const tActs = filteredActs.filter(a => tUsers.some(u => u.id === a.userId));
            entitiesToRender.push({ name: `Equipe: ${t.name}`, acts: tActs });
        });
    } else {
        let teamUsers = currentTab === 'all' ? users : users.filter(u => u.teamId === currentTab);
        if (searchTerm) teamUsers = teamUsers.filter(u => u.name.toLowerCase().includes(searchTerm));
        
        teamUsers.forEach(u => {
            const uActs = filteredActs.filter(a => a.userId === u.id);
            entitiesToRender.push({ name: u.name, acts: uActs });
        });
    }

    // Configurações Visuais 
    const isDarkMode = document.body.classList.contains('dark-mode');
    const textColor = isDarkMode ? '#94a3b8' : '#64748b'; 
    const gridColor = isDarkMode ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';
    const lineColor = mode === 'teams' ? '#10b981' : '#38bdf8'; 
    const fillColor = mode === 'teams' ? 'rgba(16, 185, 129, 0.15)' : 'rgba(56, 189, 248, 0.15)';

    // Função auxiliar: Agrupar por data para o eixo X do gráfico
    function getTrendData(acts) {
        const grouped = {};
        acts.forEach(a => {
            const d = a.date; 
            if(!grouped[d]) grouped[d] = { qtd: 0, min: 0 };
            grouped[d].qtd += a.qtd;
            grouped[d].min += timeToMin(a.time);
        });
        
        const labels = [];
        const data = [];
        Object.keys(grouped).forEach(date => {
            const totalQtd = grouped[date].qtd;
            const totalHours = grouped[date].min / 60;
            const media = totalHours > 0 ? (totalQtd / totalHours).toFixed(2) : 0;
            labels.push(date);
            data.push(parseFloat(media));
        });
        return { labels, data };
    }

    let hasRenderedAny = false;

    // 4. Cria e renderiza cada gráfico separadamente
    entitiesToRender.forEach((entity, index) => {
        if (entity.acts.length === 0) return; // Pula se não tiver nenhum apontamento
        
        hasRenderedAny = true;
        const trend = getTrendData(entity.acts);
        
        // Criação da "Caixa" (Card) para o Gráfico
        const wrapper = document.createElement('div');
        wrapper.style.padding = '20px';
        wrapper.style.background = isDarkMode ? 'var(--bg)' : '#fff';
        wrapper.style.border = '1px solid var(--border)';
        wrapper.style.borderRadius = '12px';
        wrapper.style.boxShadow = '0 4px 6px -1px rgba(0, 0, 0, 0.05)';

        // Título do Card
        const title = document.createElement('h3');
        title.innerHTML = `<i class="ph-fill ${mode === 'teams' ? 'ph-users' : 'ph-user'}"></i> ${entity.name}`;
        title.style.marginBottom = '20px';
        title.style.color = 'var(--text)';
        title.style.fontSize = '1.1rem';
        title.style.display = 'flex';
        title.style.alignItems = 'center';
        title.style.gap = '8px';
        wrapper.appendChild(title);

        // Canvas isolado
        const canvas = document.createElement('canvas');
        canvas.id = `chart_${index}`;
        wrapper.appendChild(canvas);
        
        chartContainer.appendChild(wrapper);

        // Inicialização do Chart.js para este canvas
        const ctx = canvas.getContext('2d');
        const newChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: trend.labels,
                datasets: [{
                    label: 'Média Diária',
                    data: trend.data,
                    backgroundColor: fillColor, 
                    borderColor: lineColor,
                    borderWidth: 2,
                    pointBackgroundColor: lineColor,
                    pointBorderColor: isDarkMode ? '#1e293b' : '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }, 
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        titleFont: { family: 'Inter' },
                        bodyFont: { family: 'Inter', size: 14 },
                        callbacks: {
                            label: function(context) { return context.raw + ' un/h'; }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { color: textColor, font: { family: 'Inter' } },
                        grid: { color: gridColor }
                    },
                    x: {
                        ticks: { color: textColor, font: { family: 'Inter', weight: 600 } },
                        grid: { display: false }
                    }
                }
            }
        });

        chartInstances.push(newChart);
    });

    if (!hasRenderedAny) {
        chartContainer.style.display = 'block';
        chartContainer.innerHTML = `
            <div style="text-align: center; padding: 40px; color: var(--muted);">
                <i class="ph-duotone ph-chart-line-down" style="font-size: 3rem; margin-bottom: 15px;"></i>
                <p>Nenhum dado de produção encontrado para gerar os gráficos.</p>
            </div>
        `;
    }
}
