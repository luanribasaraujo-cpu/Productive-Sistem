function fetchDataForDate() {
    if (!selectedUser) return;

    const selectedDateStr = document.getElementById('modal-date-picker').value;
    if (!selectedDateStr) return;

    const [sy, sm, sd] = selectedDateStr.split('-').map(Number);
    const targetDate = new Date(sy, sm - 1, sd);

    const inputQtd = document.getElementById('input-qtd');
    const iconQtd = document.getElementById('qtd-icon');
    const inputTime = document.getElementById('input-time');
    const teamName = teams.find(t => t.id === selectedUser.teamId)?.name || '';
    const isTerceirizado = teamName.toLowerCase().includes('terceirizad');

    // --- PLANILHA (Sheets) ---
    if (!apiPlanilhaUrl) {
        inputQtd.type = "text";
        inputQtd.value = "Sem Vínculo";
        iconQtd.className = "ph-fill ph-warning-circle";
        iconQtd.style.color = "var(--danger)";
    } else {
        inputQtd.type = "text"; 
        inputQtd.value = "Sincronizando...";
        iconQtd.className = "ph ph-spinner-gap loading-spinner";
        iconQtd.style.color = "var(--accent)";
        
        fetch(`${apiPlanilhaUrl}?nome=${encodeURIComponent(selectedUser.name)}`)
            .then(response => response.json())
            .then(data => {
                inputQtd.type = "number"; 
                inputQtd.value = data.qtd || 0; 
                iconQtd.className = "ph-fill ph-check-circle";
                iconQtd.style.color = "var(--success)";
                calcMedia();
            })
            .catch(error => {
                inputQtd.type = "number";
                inputQtd.value = 0;
                iconQtd.className = "ph-fill ph-warning-circle";
                iconQtd.style.color = "var(--danger)";
            });
    }

    // --- CLOCKIFY (Respeitando a Data do Calendário) ---
    inputTime.value = ""; 
    
    if (isTerceirizado) {
        inputTime.value = "00:00";
        inputTime.disabled = true;
        inputTime.style.opacity = '0.5';
        showToast("Modo Terceirizado: Tempo não exigido.");
        return;
    }

    inputTime.disabled = false;
    inputTime.style.opacity = '1';
    
    const apiKey = apiClockifyUrl;

    if (apiKey && apiKey.length > 20) { 
        inputTime.placeholder = "Buscando...";
        
        fetch('https://api.clockify.me/api/v1/workspaces', {
            method: 'GET',
            headers: { 'X-Api-Key': apiKey }
        })
        .then(res => {
            if (!res.ok) throw new Error("Chave inválida");
            return res.json();
        })
        .then(workspaces => {
            const workspaceId = workspaces[0].id; 
            
            return fetch(`https://api.clockify.me/api/v1/workspaces/${workspaceId}/users`, {
                headers: { 'X-Api-Key': apiKey }
            })
            .then(res => res.json())
            .then(clockifyUsers => {
                const clockifyUser = clockifyUsers.find(u => u.name.toLowerCase() === selectedUser.name.toLowerCase());

                if (!clockifyUser) {
                    showToast(`"${selectedUser.name}" não existe no Clockify.`, 'error');
                    inputTime.placeholder = "";
                    return;
                }

                return fetch(`https://api.clockify.me/api/v1/workspaces/${workspaceId}/user/${clockifyUser.id}/time-entries?hydrated=true`, {
                    headers: { 'X-Api-Key': apiKey }
                })
                .then(res => res.json())
                .then(entries => {
                    let totalMinutos = 0;

                    entries.forEach(entry => {
                        const dataDaTarefa = new Date(entry.timeInterval.start);
                        
                        // Filtra horas baseando-se no dia escolhido no calendário
                        const isTargetDate = dataDaTarefa.getDate() === targetDate.getDate() &&
                                             dataDaTarefa.getMonth() === targetDate.getMonth() &&
                                             dataDaTarefa.getFullYear() === targetDate.getFullYear();
                        
                        const textoDaTarefa = JSON.stringify(entry).toLowerCase();
                        const isValidacao = textoDaTarefa.includes("valida");
                        
                        if (isTargetDate && entry.timeInterval.duration && isValidacao) {
                            const matchHours = entry.timeInterval.duration.match(/(\d+)H/);
                            const matchMinutes = entry.timeInterval.duration.match(/(\d+)M/);

                            const hours = matchHours ? parseInt(matchHours[1]) : 0;
                            const minutes = matchMinutes ? parseInt(matchMinutes[1]) : 0;

                            totalMinutos += (hours * 60) + minutes;
                        }
                    });

                    if (totalMinutos > 0) {
                        const h = String(Math.floor(totalMinutos / 60)).padStart(2, '0');
                        const m = String(totalMinutos % 60).padStart(2, '0');
                        
                        inputTime.value = `${h}:${m}`;
                        calcMedia(); 
                        showToast(`Tempo (${h}h${m}) do dia ${targetDate.toLocaleDateString('pt-BR')} puxado!`);
                    } else {
                        showToast(`Sem tarefas neste dia.`, 'error');
                    }
                    inputTime.placeholder = "";
                });
            });
        })
        .catch(err => {
            console.error(err);
            inputTime.placeholder = "";
        });
    }
}

// --- SALVAR ATIVIDADE COM DATA ESCOLHIDA ---
async function saveAct() {
    const time = document.getElementById('input-time').value;
    const qtd = Number(document.getElementById('input-qtd').value);
    const datePickerVal = document.getElementById('modal-date-picker').value;

    const teamName = teams.find(t => t.id === selectedUser.teamId)?.name || '';
    const isTerceirizado = teamName.toLowerCase().includes('terceirizad');

    if(!time && !isTerceirizado) {
        return showToast("Por favor, preencha o tempo gasto!", "error");
    }

    // Formata a data do calendário
    const [y, m, d] = datePickerVal.split('-');
    const formattedDate = `${d}/${m}/${y}`;

    const newAct = {
        id: Date.now(),
        userId: selectedUser.id,
        qtd: qtd,
        time: isTerceirizado ? '00:00' : time, 
        date: formattedDate 
    };

    // Salva na nuvem
    const { error } = await supabaseClient.from('activities').insert([newAct]);
    if (error) return showToast("Erro ao salvar histórico.", "error");

    activities.push(newAct);

    updateHistory();
    renderGrid();
    document.getElementById('input-time').value = isTerceirizado ? '00:00' : ''; 
    showToast(`Produção salva para ${formattedDate}!`);
}

function deleteAct(actId) {
    abrirConfirm("Apagar Registro", "Deseja remover esta produção do histórico do usuário? Isso afetará os cálculos totais.", async () => {
        // Apaga da nuvem
        const { error } = await supabaseClient.from('activities').delete().eq('id', actId);
        if (error) return showToast("Erro ao apagar registro.", "error");

        activities = activities.filter(a => a.id !== actId);
        updateHistory();
        renderGrid();
        showToast("Registro apagado.");
    });
}

// --- AUXILIARES ---
function timeToMin(t) { 
    if(!t) return 0; 
    const p = t.split(':').map(Number); 
    return (p[0] * 60) + p[1]; 
}

function minToTime(m) { 
    if(m === 0) return "00h00"; 
    const h = Math.floor(m / 60); 
    const mn = m % 60; 
    return `${String(h).padStart(2,'0')}h${String(mn).padStart(2,'0')}`; 
}

function calcMedia() {
    const t = document.getElementById('input-time').value;
    const q = Number(document.getElementById('input-qtd').value);
    const mediaBox = document.getElementById('m-media');
    
    if(t) {
        const p = t.split(':').map(Number);
        const dec = p[0] + (p[1]/60);
        if (dec > 0) {
            const result = (q/dec).toFixed(2);
            mediaBox.innerHTML = `${result} <span style="font-size: 1rem; color: var(--muted);">/h</span>`;
            mediaBox.style.color = "var(--success)";
        } else {
            mediaBox.innerHTML = `0.00 <span style="font-size: 1rem; color: var(--muted);">/h</span>`;
        }
    }
}

function updateHistory() {
    const hist = document.getElementById('m-history');
    const uActs = activities.filter(a => a.userId === selectedUser.id);
    
    if (uActs.length === 0) {
        hist.innerHTML = `
            <div style="color: var(--muted); font-size: 0.85rem; text-align: center; padding: 20px; background: rgba(0,0,0,0.1); border-radius: 10px; border: 1px dashed var(--border);">
                Nenhum registro no histórico.
            </div>`;
        return;
    }

    hist.innerHTML = uActs.reverse().map(a => `
        <div style="background: rgba(255,255,255,0.03); padding: 12px 15px; border-radius: 10px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem; transition: 0.2s; border: 1px solid transparent;" onmouseover="this.style.borderColor='var(--border)'" onmouseout="this.style.borderColor='transparent'">
            <span style="display: flex; gap: 15px;">
                <b style="color: var(--text);">${a.date}</b> 
                <span style="color: var(--muted);"><i class="ph-fill ph-clock"></i> ${a.time}</span>
            </span>
            <div style="display: flex; align-items: center; gap: 15px;">
                <span style="background: rgba(16, 185, 129, 0.1); color: var(--success); padding: 4px 10px; border-radius: 20px; font-weight: bold; font-size: 0.8rem;">${a.qtd} un.</span>
                <button onclick="deleteAct(${a.id})" style="background: none; border: none; color: var(--danger); cursor: pointer; padding: 5px; border-radius: 5px; display: flex; transition: 0.2s;" onmouseover="this.style.background='rgba(239, 68, 68, 0.1)'" onmouseout="this.style.background='none'" title="Apagar registro">
                    <i class="ph-fill ph-trash"></i>
                </button>
            </div>
        </div>
    `).join('');
}

function showToast(msg, type = 'success') {
    const c = document.getElementById('toasts');
    const t = document.createElement('div');
    t.className = 'toast';
    if(type === 'error') {
        t.style.borderLeftColor = 'var(--danger)';
        t.innerHTML = `<i class="ph-fill ph-warning-circle" style="color: var(--danger); font-size: 1.2rem;"></i> ${msg}`;
    } else {
        t.innerHTML = `<i class="ph-fill ph-check-circle" style="color: var(--success); font-size: 1.2rem;"></i> ${msg}`;
    }
    c.appendChild(t);
    setTimeout(() => {
        t.style.animation = 'slideIn 0.4s reverse forwards';
        setTimeout(() => t.remove(), 400);
    }, 3000);
}

