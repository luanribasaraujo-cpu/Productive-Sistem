window.renderCharts = async function() {
    const p = document.getElementById('chart-period-preset'); if (!p) return;
    const m = document.getElementById('chart-mode').value, src = document.getElementById('chart-search')?.value.toLowerCase() || '', is = document.getElementById('chart-date-start')?.value || '', ie = document.getElementById('chart-date-end')?.value || '';
    let sd = new Date(), ed = new Date(); sd.setHours(0,0,0,0); ed.setHours(23,59,59,999);
    
    if (p.value === 'custom' && is && ie) { 
        const [y1,m1,d1] = is.split('-'); sd = new Date(y1, m1-1, d1, 0,0,0); 
        const [y2,m2,d2] = ie.split('-'); ed = new Date(y2, m2-1, d2, 23,59,59,999); 
    } else { 
        if (p.value === 'yesterday') { sd.setDate(sd.getDate()-1); ed.setDate(ed.getDate()-1); } 
        else if (p.value === 'week') { sd.setDate(sd.getDate() - sd.getDay()); } 
        else if (p.value === 'last_week') { sd.setDate(sd.getDate() - sd.getDay() - 7); ed.setDate(ed.getDate() - ed.getDay() - 1); } 
        else if (p.value === 'month') { sd.setDate(1); } 
        else if (p.value === 'all') { sd = new Date(2020,0,1); } 
    }
    
    let { data: dbAp } = await supabaseClient.from('apontamentos').select('*').gte('inicio', sd.toISOString()).lte('inicio', ed.toISOString()).not('duracao_segundos', 'is', null); 
    dbAp = dbAp || [];
    
    let lbl = [], hD = []; 
    if (m === 'members') {
        let uS = {}; 
        users.forEach(u => { 
            if (currentTab !== 'all' && u.teamId !== currentTab) return; 
            if (src && !u.name.toLowerCase().includes(src)) return; 
            uS[u.id] = { name: u.name, secs: 0 }; 
        });
        dbAp.forEach(ap => { 
            if (uS[ap.usuario_id]) { uS[ap.usuario_id].secs += ap.duracao_segundos; } 
        });
        Object.values(uS).forEach(s => { 
            lbl.push(s.name); 
            hD.push((s.secs / 3600).toFixed(2)); 
        });
    } else {
        let tS = {}; 
        teams.forEach(t => { 
            if (currentTab !== 'all' && t.id !== currentTab) return; 
            tS[t.id] = { name: t.name, secs: 0 }; 
        });
        dbAp.forEach(ap => { 
            const u = users.find(x => String(x.id) === String(ap.usuario_id)); 
            if (u && tS[u.teamId]) { tS[u.teamId].secs += ap.duracao_segundos; } 
        });
        Object.values(tS).forEach(s => { 
            lbl.push(s.name); 
            hD.push((s.secs / 3600).toFixed(2)); 
        });
    }
    
    const ctx = document.getElementById('teamChart').getContext('2d'); 
    if (chartInstances.length > 0) { chartInstances.forEach(c => c.destroy()); chartInstances = []; }
    
    chartInstances.push(new Chart(ctx, { 
        type: 'bar', 
        data: { labels: lbl, datasets: [ { label: 'Horas Trabalhadas', data: hD, backgroundColor: '#38bdf8', borderRadius: 4 } ] }, 
        options: { 
            responsive: true, maintainAspectRatio: false, 
            scales: { y: { title: { display: true, text: 'Horas (h)', color: '#38bdf8' }, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#38bdf8' } }, x: { grid: { display: false }, ticks: { color: '#94a3b8', font: {weight: 'bold'} } } }, 
            plugins: { legend: { labels: { color: '#f8fafc' } } } 
        } 
    }));
}

window.exportarDadosCSV = async function() {
    if(chartInstances.length === 0) return showToast("Sem dados.", "error"); 
    showToast("A gerar CSV..."); 
    const c = chartInstances[0];
    let csv = "data:text/csv;charset=utf-8,Nome,Horas Trabalhadas\n"; 
    for(let i=0; i<c.data.labels.length; i++) { csv += `${c.data.labels[i]},${c.data.datasets[0].data[i]}\n`; }
    const a = document.createElement("a"); a.href = encodeURI(csv); a.download = "relatorio_horas.csv"; document.body.appendChild(a); a.click(); document.body.removeChild(a); showToast("Concluído!");
}

