        currentTrackingId = res.data.id; trackerStartTime = new Date(res.data.inicio); 
        
        const ativInput = document.getElementById('tracker-atividade');
        const descInput = document.getElementById('tracker-descricao');
        if(ativInput) ativInput.value = res.data.atividade_id || ""; 
        if(descInput) descInput.value = res.data.descricao || ""; 

