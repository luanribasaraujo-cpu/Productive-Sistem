:root {
    color-scheme: light; /* Ativa dropdowns nativos bonitos e calendário nativo claro */
    --bg: #f8fafc;           
    --sidebar: #ffffff;      
    --card: #ffffff;         
    --text: #0f172a;         
    --muted: #64748b;        
    --accent: #2563eb;       
    --accent-hover: #1d4ed8; 
    --danger: #ef4444;       
    --success: #22c55e;
    --warning: #f59e0b;
    --border: rgba(0, 0, 0, 0.1); 
    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    --shadow-lg: 0 20px 40px -10px rgba(0, 0, 0, 0.15);
}

body.dark-mode {
    color-scheme: dark; /* Ativa dropdowns nativos escuros e calendário escuro */
    --bg: #121214; 
    --sidebar: #1c1c1f; 
    --card: #29292e; 
    --text: #f8f8f2; 
    --muted: #a8a8b3;
    --accent: #00e7df; 
    --accent-hover: #00c4bd; 
    --border: rgba(255, 255, 255, 0.15);
    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 20px 40px -10px rgba(0, 0, 0, 0.7);
}

* { box-sizing: border-box; }

body { 
    font-family: 'Inter', sans-serif; background-color: var(--bg); color: var(--text); 
    margin: 0; display: flex; height: 100vh; overflow: hidden; 
}

.hidden { display: none !important; }

/* --- SIDEBAR E ESTRUTURA BASE --- */
aside { width: 260px; background: var(--sidebar); border-right: 1px solid var(--border); display: flex; flex-direction: column; padding: 20px; flex-shrink: 0; z-index: 10; box-shadow: 2px 0 10px rgba(0,0,0,0.03); }
.sidebar-header { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.1rem; margin-bottom: 30px; color: var(--accent); }
.team-tabs { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 5px; margin-bottom: 10px; }
.tab-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 15px; border-radius: 10px; cursor: pointer; transition: 0.2s; color: var(--muted); font-weight: 600; border: 1px solid transparent; }
.tab-item:hover { background: rgba(0,0,0,0.03); color: var(--text); }
.tab-item.active { background: rgba(37, 99, 235, 0.1); color: var(--accent); border-color: rgba(37, 99, 235, 0.2); }
.tab-item .btn-del-team { opacity: 0; transition: 0.2s; color: var(--danger); font-size: 1.2rem; }
.tab-item:hover .btn-del-team { opacity: 1; }

.btn-add-team { background: transparent; border: 1px dashed var(--muted); color: var(--muted); padding: 12px; border-radius: 8px; cursor: pointer; width: 100%; transition: 0.2s; display: flex; justify-content: center; align-items: center; gap: 8px; font-weight: 600; }
.btn-add-team:hover { border-color: var(--accent); color: var(--accent); background: rgba(37, 99, 235, 0.05); }

main { flex: 1; display: flex; flex-direction: column; overflow-y: auto; background: var(--bg); }
.top-bar { padding: 20px 40px; border-bottom: 1px solid var(--border); background: rgba(255, 255, 255, 0.9); display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 5; }
body.dark-mode .top-bar { background: rgba(18, 18, 20, 0.8); }

.search-container { display: flex; align-items: center; background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0 15px; width: 350px; transition: 0.3s; }
.search-container:focus-within { border-color: var(--accent); box-shadow: 0 0 15px rgba(37, 99, 235, 0.15); }
.search-container input { border: none; background: transparent; color: var(--text); padding: 12px; width: 100%; outline: none; }
.search-container i { color: var(--muted); }

/* --- CONTEÚDO E CARDS --- */
.content-body { padding: 40px; max-width: 1300px; margin: 0 auto; width: 100%; }
.stats-row { display: flex; gap: 20px; margin-bottom: 30px; }
.stat-card { background: var(--card); padding: 20px 25px; border-radius: 15px; border: 1px solid var(--border); flex: 1; box-shadow: var(--shadow-sm); }
.stat-card span { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; font-weight: 700; letter-spacing: 1.5px; }
.stat-card h2 { margin: 5px 0 0 0; font-size: 2rem; color: var(--text); }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px; }

.card-user { background: var(--card); border-radius: 20px; border: 1px solid var(--border); padding: 20px; cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; }
.card-user:hover { transform: translateY(-5px); border-color: var(--accent); box-shadow: 0 12px 30px -10px rgba(37, 99, 235, 0.2); }
.card-user img { width: 100%; height: 240px; border-radius: 15px; object-fit: cover; margin-bottom: 15px; background: var(--bg); }
.card-user h3 { margin: 0; font-size: 1.2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text); }
.card-user .team-badge { position: absolute; top: 30px; right: 30px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(4px); color: var(--accent); border: 1px solid var(--accent); font-size: 0.65rem; padding: 4px 10px; border-radius: 20px; font-weight: 800; text-transform: uppercase; }

.empty-state { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; text-align: center; color: var(--muted); background: rgba(0,0,0,0.02); border-radius: 20px; border: 1px dashed var(--border); }
.empty-state i { font-size: 4rem; margin-bottom: 15px; opacity: 0.5; }
body.dark-mode .empty-state { background: rgba(255,255,255,0.02); border-color: rgba(255, 255, 255, 0.1); }

/* --- BOTÕES --- */
button.primary { background: linear-gradient(135deg, var(--accent) 0%, var(--accent-hover) 100%); color: white; border: none; padding: 12px 25px; border-radius: 10px; font-weight: 700; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 8px; justify-content: center; }
button.primary:hover { transform: scale(1.02); box-shadow: 0 6px 15px rgba(37, 99, 235, 0.3); }
button.danger { background: var(--danger); color: white; }
button.danger:hover { background: #dc2626; box-shadow: 0 6px 15px rgba(239, 68, 68, 0.3); }
button.outline { background: transparent; color: var(--text); border: 1px solid var(--muted); }
button.outline:hover { background: rgba(0,0,0,0.05); }
button.close-btn { background: rgba(0,0,0,0.05); border: 1px solid transparent; color: var(--text); cursor: pointer; font-size: 1.2rem; transition: 0.2s; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; }
button.close-btn:hover { background: rgba(239, 68, 68, 0.1); color: var(--danger); border-color: rgba(239, 68, 68, 0.3); transform: rotate(90deg); }

/* --- INPUTS GERAIS --- */
.input-group { background: rgba(0,0,0,0.03); padding: 20px; border-radius: 15px; border-left: 4px solid var(--accent); margin-bottom: 20px; }
input { background: var(--card); border: 1px solid var(--border); color: var(--text); padding: 14px; border-radius: 8px; width: 100%; font-family: inherit; margin-top: 5px; transition: 0.3s; outline: none; }
input:focus { border-color: var(--accent); box-shadow: 0 0 15px rgba(37, 99, 235, 0.15); } 

/* --- SELECTS NATIVOS (CAIXAS COM BORDA) --- */
.native-select {
    background-color: transparent;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px;
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    transition: 0.3s;
}
.native-select:focus { border-color: var(--accent); }

/* --- CUSTOM DROPDOWN (SUBSTITUI SELECT FEIO) --- */
.custom-select {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0,0,0,0.2);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 12px 15px;
    border-radius: 8px;
    cursor: pointer;
    user-select: none;
    transition: all 0.2s ease;
}
.custom-select:hover {
    background: rgba(0,0,0,0.4);
    border-color: var(--accent);
}
.custom-options-menu {
    position: absolute;
    top: calc(100% + 5px);
    left: 0;
    right: 0;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
    z-index: 1000;
    max-height: 250px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: 5px;
}
.custom-option {
    padding: 12px 15px;
    border-radius: 8px;
    cursor: pointer;
    color: var(--text);
    font-weight: 600;
    font-size: 0.9rem;
    transition: 0.2s;
}
.custom-option:hover {
    background: rgba(37, 99, 235, 0.1);
    color: var(--accent);
}

/* --- MODAIS & TOASTS --- */
.modal-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; z-index: 1000; opacity: 0; pointer-events: none; transition: 0.3s; }
.modal-overlay:not(.hidden) { opacity: 1; pointer-events: all; }
.modal-overlay:not(.hidden) .modal-box { animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
@keyframes popIn { 0% { opacity: 0; transform: scale(0.9) translateY(20px); } 100% { opacity: 1; transform: scale(1) translateY(0); } }

.modal-box { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-radius: 20px; border: 1px solid rgba(0, 0, 0, 0.1); width: min(800px, 95%); max-height: 90vh; overflow-y: auto; position: relative; transform: translateY(20px); transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3); }
body.dark-mode .modal-box { background: rgba(28, 28, 31, 0.85); }
.modal-grid { display: grid; grid-template-columns: 320px 1fr; gap: 30px; padding: 40px; }
@media (max-width: 768px) { .modal-grid { grid-template-columns: 1fr; } .top-bar { flex-direction: column; gap: 15px; } .search-container { width: 100%; } }

.toast-container { position: fixed; bottom: 20px; right: 20px; z-index: 2000; display: flex; flex-direction: column; gap: 10px; }
.toast { background: var(--card); border-left: 4px solid var(--success); color: var(--text); padding: 16px 25px; border-radius: 10px; display: flex; align-items: center; gap: 12px; box-shadow: var(--shadow-lg); font-weight: 600; border: 1px solid var(--border); animation: slideIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
@keyframes slideIn { from { transform: translateX(120%); } to { transform: translateX(0); } }

/* --- ANIMAÇÕES E EXTRAS --- */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: rgba(0,0,0,0.1); border-radius: 10px; }
::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.2); border-radius: 10px; }
body.dark-mode ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); }
::-webkit-scrollbar-thumb:hover { background: var(--accent); }

button:active { transform: scale(0.95); }

.skeleton { background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.03) 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: 8px; color: transparent !important; pointer-events: none; border: none !important; }
.skeleton * { visibility: hidden; }
@keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }

[data-tooltip] { position: relative; cursor: pointer; }
[data-tooltip]:hover::after { content: attr(data-tooltip); position: absolute; bottom: 120%; left: 50%; transform: translateX(-50%) translateY(10px); background: #0f172a; color: #f8fafc; padding: 6px 12px; font-size: 0.75rem; border-radius: 6px; white-space: nowrap; pointer-events: none; opacity: 0; transition: all 0.2s ease; box-shadow: 0 4px 6px rgba(0,0,0,0.5); z-index: 9999; font-weight: 600; border: 1px solid rgba(255,255,255,0.1); }
[data-tooltip]:hover::before { content: ''; position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%) translateY(10px); border-width: 6px; border-style: solid; border-color: #0f172a transparent transparent transparent; pointer-events: none; opacity: 0; transition: all 0.2s ease; z-index: 9999; }
[data-tooltip]:hover::after, [data-tooltip]:hover::before { opacity: 1; transform: translateX(-50%) translateY(0); }

.admin-panel-section { background: rgba(0,0,0,0.2); border: 1px solid var(--border); border-radius: 12px; margin-bottom: 12px; overflow: hidden; transition: all 0.3s ease; }
.admin-panel-section summary { padding: 15px; font-weight: 700; cursor: pointer; outline: none; list-style: none; display: flex; justify-content: space-between; align-items: center; color: var(--text); background: rgba(255,255,255,0.03); margin: 0; user-select: none; }
.admin-panel-section summary::-webkit-details-marker { display: none; }
.admin-panel-section summary h4 { margin: 0; display: flex; align-items: center; gap: 10px; font-size: 0.95rem; }
.admin-panel-section summary:after { content: '▼'; font-size: 0.7rem; color: var(--muted); transition: transform 0.3s; }
.admin-panel-section[open] summary:after { transform: rotate(180deg); }
.admin-panel-content { padding: 20px; border-top: 1px solid var(--border); }

/* --- FOLHA DE HORAS (LISTAGEM LIMPA E INVISÍVEL) --- */
.history-group-header { font-size: 0.8rem; font-weight: 700; color: var(--muted); border-bottom: 1px solid var(--border); padding-bottom: 8px; margin-bottom: 10px; margin-top: 25px; text-align: left; text-transform: uppercase; letter-spacing: 1px; }
.history-group-header:first-child { margin-top: 0; }
.history-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 15px; border-bottom: 1px solid rgba(255,255,255,0.03); transition: 0.2s; border-left: 3px solid transparent; }
.history-row:hover { background: rgba(255,255,255,0.02); }
.history-row.active { border-left-color: var(--success); background: rgba(34, 197, 94, 0.05); }
.history-main { display: flex; align-items: center; gap: 15px; flex: 1; }
.color-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex-shrink: 0; box-shadow: 0 0 8px rgba(0,0,0,0.5); }
.history-text { display: flex; flex-direction: column; text-align: left; }
.history-text strong { font-size: 0.95rem; color: var(--text); }
.history-text small { font-size: 0.75rem; color: var(--muted); margin-top: 3px; }
.history-meta { display: flex; align-items: center; gap: 20px; font-family: monospace; font-size: 0.9rem; color: var(--muted); }
.history-duration { font-weight: 800; color: var(--text); min-width: 65px; text-align: right; }
.btn-play-history { background: transparent; border: 1px solid transparent; color: var(--muted); cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center; padding: 8px; border-radius: 8px; font-size: 1.1rem; }
.btn-play-history:hover { color: var(--success); background: rgba(34, 197, 94, 0.1); border-color: rgba(34, 197, 94, 0.2); }

/* --- INPUTS DE TEMPO COMPLETAMENTE LIMPOS (TEXTO PURO) --- */
.inline-time-edit {
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    color: var(--text) !important;
    font-family: monospace;
    font-size: 1.05rem !important;
    font-weight: 800 !important;
    width: auto !important;
    text-align: center;
    cursor: pointer;
    padding: 4px 6px !important;
    transition: 0.2s;
    border-radius: 6px;
    margin: 0;
}
.inline-time-edit:hover, .inline-time-edit:focus {
    background: rgba(128, 128, 128, 0.15) !important;
}
.inline-time-edit:disabled { cursor: not-allowed; opacity: 0.5; background: transparent !important; }
input[type="time"]::-webkit-calendar-picker-indicator { display: none; -webkit-appearance: none; }

#tracker-display { color: var(--text) !important; text-shadow: none !important; letter-spacing: 4px !important; }
