<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Produção - Checklists</title>
    <style>
        /* --- ESTILOS GERAIS --- */
        :root {
            --bg: #0f172a; --card: #1e293b; --text: #f1f5f9; --muted: #94a3b8;
            --accent: #38bdf8; --danger: #ef4444; --success: #10b981;
            --border: rgba(255, 255, 255, 0.1);
        }
        body { font-family: 'Inter', sans-serif; background-color: var(--bg); color: var(--text); margin: 0; min-height: 100vh; }
        .hidden { display: none !important; }
        
        /* Layout */
        .top-nav { display: flex; justify-content: space-between; padding: 20px; align-items: center; border-bottom: 1px solid var(--border); background: var(--card); }
        main { padding: 20px; max-width: 1200px; margin: 0 auto; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-top: 20px; }

        /* Cards */
        .card-container { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 16px; position: relative; transition: transform 0.2s; cursor: pointer; }
        .card-container:hover { transform: translateY(-5px); border-color: var(--accent); }
        .avatar { width: 100%; height: 220px; border-radius: 8px; object-fit: cover; background: #111; margin-bottom: 12px; opacity: 0.9; }
        .tags { margin-top: 12px; display: flex; gap: 6px; flex-wrap: wrap; }
        .tag { font-size: 12px; padding: 6px 12px; border-radius: 6px; background: rgba(255, 255, 255, 0.05); color: #cbd5e1; border: 1px solid var(--border); }

        /* Botões */
        .nav-btn-secondary { background: transparent; border: 1px solid var(--accent); color: var(--accent); padding: 8px 15px; border-radius: 6px; cursor: pointer; font-weight: bold; transition: 0.2s; }
        .nav-btn-secondary:hover { background: var(--accent); color: var(--bg); }
        button.action-btn { background: var(--accent); color: #000; font-weight: bold; border: none; padding: 12px 20px; border-radius: 6px; cursor: pointer; width: 100%; transition: 0.2s; margin-top: 10px; }

        /* Modal */
        .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; z-index: 100; backdrop-filter: blur(5px); padding: 20px; }
        .modal { width: min(850px, 100%); background: var(--card); border-radius: 16px; border: 1px solid rgba(255,255,255,0.1); max-height: 90vh; overflow-y: auto; position: relative; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); }
        .modal-content { display: flex; gap: 32px; padding: 32px; }
        @media(max-width: 768px){ .modal-content {flex-direction: column;} .thumb {width: 100%; height: 200px;} }
        .thumb { width: 280px; height: 350px; border-radius: 12px; object-fit: cover; flex-shrink: 0; }
        .close { position: absolute; top: 20px; right: 20px; background: rgba(255,255,255,0.1); border: none; color: white; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; font-size: 20px; z-index: 10; }
        .close:hover { background: var(--danger); }
        .right-panel { flex: 1; width: 100%; }

        /* Inputs & Form */
        .input-group { background: rgba(0,0,0,0.2); padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid var(--border); border-left: 4px solid var(--accent); }
        input { background: #0f172a; border: 1px solid var(--border); color: white; padding: 10px; border-radius: 6px; width: 100%; box-sizing: border-box; margin-top: 5px; }
    </style>
</head>
<body>

    <div class="top-nav">
        <div style="font-weight: bold; font-size: 1.2rem;">Dashboard de Produção</div>
        <button class="nav-btn-secondary" onclick="abrirAdmin()">⚙️ Gerenciar Equipe</button>
    </div>

    <main>
        <div class="grid" id="users-grid"></div>
    </main>

    <div id="modal-admin" class="modal-backdrop hidden" style="z-index: 200;">
        <div class="modal" style="width: 450px;">
            <div style="padding: 30px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
                    <h2 style="margin:0; color: var(--accent);">⚙️ Gerenciar Equipe</h2>
                    <button onclick="fecharAdmin()" style="background:none; border:none; color:white; font-size:1.5rem; cursor:pointer;">×</button>
                </div>
                
                <div class="input-group" style="border-left-color: var(--success);">
                    <label style="color:var(--muted); font-size:0.8rem">Novo Integrante</label>
                    <div style="display: flex; gap: 10px; align-items: flex-end;">
                        <div style="flex: 1;">
                            <input type="text" id="new-user-name" placeholder="Nome do integrante" style="margin:0;">
                        </div>
                        <button class="action-btn" style="width: auto; margin:0; background: var(--success);" onclick="addUser()">Adicionar</button>
                    </div>
                </div>

                <h4 style="color: var(--muted); border-bottom:1px solid var(--border); padding-bottom:5px;">Membros Ativos</h4>
                <div id="admin-users-list" style="display: flex; flex-direction: column; gap: 10px; max-height: 300px; overflow-y: auto;">
                    </div>
            </div>
        </div>
    </div>

    <div id="modal-backdrop" class="modal-backdrop hidden">
        <div class="modal">
            <button class="close" onclick="fecharModal()">×</button>
            <div class="modal-content">
                <img src="" id="modal-avatar" class="thumb">
                
                <div class="right-panel">
                    <h2 id="modal-name" style="margin-top: 0;">Nome</h2>
                    
                    <div style="display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap;">
                        <div class="tag">Horas Locais: <strong id="modal-total-hours" style="color:white">00:00</strong></div>
                        <div class="tag">Apontamentos Locais: <strong id="modal-total-qtd" style="color:white">0</strong></div>
                        <div class="tag" style="border-color: var(--accent); background: rgba(56, 189, 248, 0.1);">
                            Checklists Planilha: <strong id="modal-api-qtd" style="color:var(--accent)">Carregando...</strong>
                        </div>
                    </div>

                    <div id="form-container" class="input-group">
                        <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                            <div style="flex: 1;">
                                <label style="color:var(--muted); font-size:0.8rem">Checklists (Puxado da Planilha)</label>
                                <input type="number" id="input-qtd" readonly style="background: rgba(255,255,255,0.05); color: var(--accent); font-weight: bold;" value="0">
                            </div>
                            <div style="flex: 1;">
                                <label style="color:var(--muted); font-size:0.8rem">Tempo Utilizado</label>
                                <input type="time" id="input-time" oninput="calcularMedia()" required>
                            </div>
                        </div>
                        
                        <div style="text-align: center; background: rgba(0,0,0,0.3); padding: 15px; border-radius: 6px; border: 1px solid var(--border);">
                            Média desta sessão: <br>
                            <strong id="calc-projecao" style="color: var(--accent); font-size: 1.5rem;">0.00 /h</strong>
                        </div>

                        <button class="action-btn" onclick="salvarAtividade()">Registrar Apontamento</button>
                    </div>

                    <h4 style="color: var(--muted); border-bottom:1px solid var(--border); padding-bottom:5px;">Histórico Local</h4>
                    <ul id="history-list" style="list-style: none; padding: 0; max-height: 200px; overflow-y: auto;"></ul>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ==========================================
        // 🔗 COLOQUE AQUI O SEU LINK DO GOOGLE APPS SCRIPT
        // ==========================================
        const URL_API = "SUA_URL_DO_APPS_SCRIPT_AQUI"; 

        // --- DADOS INICIAIS ---
        let usersDB = JSON.parse(localStorage.getItem('users_db_v6')) || [
            { id: 1, name: "Luan", avatar: "https://ui-avatars.com/api/?name=Luan&background=38bdf8&color=fff" },
            { id: 2, name: "Rapha", avatar: "https://ui-avatars.com/api/?name=Rapha&background=38bdf8&color=fff" }
        ];

        let selectedUserForModal = null;
        let activities = JSON.parse(localStorage.getItem('activities_db_v5')) || [];

        window.onload = () => renderGrid();

        // ==========================================
        // PAINEL ADMIN (GERENCIAR USUÁRIOS)
        // ==========================================
        function abrirAdmin() {
            document.getElementById('modal-admin').classList.remove('hidden');
            renderAdminUsers();
        }

        function fecharAdmin() {
            document.getElementById('modal-admin').classList.add('hidden');
        }

        function renderAdminUsers() {
            const list = document.getElementById('admin-users-list');
            list.innerHTML = '';
            usersDB.forEach(u => {
                list.innerHTML += `
                    <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.05); padding: 10px 15px; border-radius: 6px; border: 1px solid var(--border);">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <img src="${u.avatar}" style="width: 30px; height: 30px; border-radius: 50%;">
                            <span style="font-weight: bold;">${u.name}</span>
                        </div>
                        <button onclick="deleteUser(${u.id})" style="background:none; border:none; color: var(--danger); cursor:pointer; font-weight: bold; font-size: 0.9rem;">Remover</button>
                    </div>
                `;
            });
        }

        function addUser() {
            const nameInput = document.getElementById('new-user-name');
            const name = nameInput.value.trim();
            if (!name) return alert('Por favor, digite um nome!');
            
            const newId = Date.now();
            // Gera um avatar automático bonito com a letra do nome
            const avatar = `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=38bdf8&color=fff`;
            
            usersDB.push({ id: newId, name: name, avatar: avatar });
            localStorage.setItem('users_db_v6', JSON.stringify(usersDB));
            
            nameInput.value = '';
            renderAdminUsers();
            renderGrid();
        }

        function deleteUser(id) {
            if(confirm("Tem certeza que deseja remover este usuário?")) {
                usersDB = usersDB.filter(u => u.id !== id);
                localStorage.setItem('users_db_v6', JSON.stringify(usersDB));
                renderAdminUsers();
                renderGrid();
            }
        }

        // ==========================================
        // INTEGRAÇÃO COM API (GOOGLE SHEETS)
        // ==========================================
        async function buscarCheckboxes(nomeUsuario) {
            const inputQtd = document.getElementById('input-qtd');
            const displayApi = document.getElementById('modal-api-qtd');
            
            inputQtd.value = "⏳";
            displayApi.innerText = "Buscando...";
            
            if (URL_API === "SUA_URL_DO_APPS_SCRIPT_AQUI") {
                inputQtd.value = "0";
                displayApi.innerText = "Link não configurado";
                return;
            }

            try {
                const response = await fetch(URL_API);
                const dados = await response.json();
                const dadosUsuario = dados.find(d => d.nome === nomeUsuario);
                
                if (dadosUsuario) {
                    inputQtd.value = dadosUsuario.checklistsConcluidos;
                    displayApi.innerText = dadosUsuario.checklistsConcluidos;
                } else {
                    inputQtd.value = "0";
                    displayApi.innerText = "0";
                }
            } catch (error) {
                inputQtd.value = "0";
                displayApi.innerText = "Erro de conexão";
                console.error("Erro ao puxar dados da API:", error);
            }
            
            calcularMedia();
        }

        async function enviarDadosAPI(nome, producao, tempoHorasDecimais) {
            if (URL_API === "SUA_URL_DO_APPS_SCRIPT_AQUI") return;
            try {
                await fetch(URL_API, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        nome: nome,
                        producao: producao,
                        tempo: tempoHorasDecimais
                    })
                });
            } catch (error) {
                console.error("Erro ao enviar para API:", error);
            }
        }

        // ==========================================
        // UTILITÁRIOS
        // ==========================================
        function timeToMin(t) { 
            if(!t) return 0; 
            const parts = t.split(':').map(Number);
            return (parts[0] * 60) + parts[1]; 
        }
        
        function minToTime(m) { 
            const h = Math.floor(m / 60); 
            const mn = m % 60; 
            return `${String(h).padStart(2,'0')}h ${String(mn).padStart(2,'0')}m`; 
        }

        // ==========================================
        // GRID PRINCIPAL E MODAL
        // ==========================================
        function renderGrid() {
            const grid = document.getElementById('users-grid');
            grid.innerHTML = '';
            
            usersDB.forEach(user => {
                // Como tiramos o filtro de data, ele agora carrega todos os registros do histórico local desse usuário
                const userActs = activities.filter(a => a.userId === user.id);
                const totalQtd = userActs.reduce((acc, c) => acc + c.qtd, 0);
                const totalMin = userActs.reduce((acc, c) => acc + timeToMin(c.time), 0);

                grid.innerHTML += `
                    <div class="card-container" onclick="abrirModal(${user.id})">
                        <img class="avatar" src="${user.avatar}">
                        <h3 style="margin:0">${user.name}</h3>
                        <div class="tags">
                            <span class="tag">⏱ ${minToTime(totalMin)} local</span>
                            <span class="tag">📦 ${totalQtd} local</span>
                        </div>
                    </div>
                `;
            });
        }

        function abrirModal(userId) {
            const user = usersDB.find(u => u.id === userId);
            selectedUserForModal = user;
            
            document.getElementById('modal-backdrop').classList.remove('hidden');
            document.getElementById('modal-avatar').src = user.avatar;
            document.getElementById('modal-name').innerText = user.name;
            
            document.getElementById('input-time').value = '';
            document.getElementById('calc-projecao').innerText = '0.00 /h';
            
            atualizarHistorico();
            buscarCheckboxes(user.name);
        }

        function fecharModal() {
            document.getElementById('modal-backdrop').classList.add('hidden');
            renderGrid();
        }

        // ==========================================
        // CÁLCULO E REGISTRO
        // ==========================================
        function calcularMedia() {
            const tempoStr = document.getElementById('input-time').value;
            const qtd = Number(document.getElementById('input-qtd').value) || 0;
            let media = 0;
            
            if(tempoStr) {
                const parts = tempoStr.split(':').map(Number);
                const horasDecimais = parts[0] + (parts[1] / 60);
                if (horasDecimais > 0) {
                    media = (qtd / horasDecimais).toFixed(2);
                }
            }
            document.getElementById('calc-projecao').innerText = `${media} /h`;
        }

        function atualizarHistorico() {
            const userActs = activities.filter(a => a.userId === selectedUserForModal.id);
            
            document.getElementById('modal-total-hours').innerText = minToTime(userActs.reduce((acc, c) => acc + timeToMin(c.time), 0));
            document.getElementById('modal-total-qtd').innerText = userActs.reduce((acc, c) => acc + c.qtd, 0);

            const list = document.getElementById('history-list');
            list.innerHTML = '';
            [...userActs].reverse().forEach(act => {
                const parts = act.time.split(':').map(Number);
                const horas = parts[0] + (parts[1] / 60);
                const rate = horas > 0 ? (act.qtd / horas).toFixed(1) : 0;
                
                list.innerHTML += `
                    <li style="background:rgba(255,255,255,0.05); padding:10px; margin-bottom:5px; border-radius:6px; display:flex; justify-content:space-between; align-items:center;">
                        <div style="font-size:0.75rem; color:#888;">${act.date}</div>
                        <div style="text-align:right; display:flex; align-items:center; gap:10px;">
                            <div>
                                <strong style="color:var(--accent)">${act.qtd} un.</strong>
                                <div style="font-size:0.85rem;">⏱ ${act.time}</div>
                                <div style="font-size:0.75rem; color:var(--muted);">(${rate} /h)</div>
                            </div>
                            <button onclick="delAct(${act.id})" style="background:none;border:none;color:var(--danger);cursor:pointer;font-size:1.2rem;">&times;</button>
                        </div>
                    </li>
                `;
            });
        }

        function salvarAtividade() {
            let tempo = document.getElementById('input-time').value;
            let qtd = Number(document.getElementById('input-qtd').value);

            if (!tempo) {
                alert("Por favor, preencha o Tempo Utilizado!");
                return;
            }

            const parts = tempo.split(':').map(Number);
            const horasDecimais = parts[0] + (parts[1] / 60);

            activities.push({
                id: Date.now(),
                userId: selectedUserForModal.id,
                qtd: qtd, 
                time: tempo,      
                date: new Date().toLocaleDateString('pt-BR')
            });
            localStorage.setItem('activities_db_v5', JSON.stringify(activities));
            
            enviarDadosAPI(selectedUserForModal.name, qtd, horasDecimais.toFixed(2));

            document.getElementById('input-time').value = '';
            document.getElementById('calc-projecao').innerText = '0.00 /h';
            atualizarHistorico();
        }

        function delAct(id) {
            if(confirm("Deseja realmente apagar este registro do histórico local?")) {
                activities = activities.filter(a => a.id !== id);
                localStorage.setItem('activities_db_v5', JSON.stringify(activities));
                atualizarHistorico();
            }
        }
    </script>
</body>
</html>
