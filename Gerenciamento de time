<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Produção Pro - Equipes</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <style>
        :root {
            --bg: #0f172a; --sidebar: #1e293b; --card: #1e293b; --text: #f1f5f9; --muted: #94a3b8;
            --accent: #38bdf8; --accent-hover: #0284c7; --danger: #ef4444; --success: #10b981;
            --border: rgba(255, 255, 255, 0.08);
            --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        * { box-sizing: border-box; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }

        body { 
            font-family: 'Inter', sans-serif; background-color: var(--bg); color: var(--text); 
            margin: 0; display: flex; height: 100vh; overflow: hidden; 
        }

        .hidden { display: none !important; }

        /* --- SIDEBAR (EQUIPES) --- */
        aside {
            width: 260px; background: var(--sidebar); border-right: 1px solid var(--border);
            display: flex; flex-direction: column; padding: 20px; flex-shrink: 0;
            z-index: 10;
            box-shadow: 2px 0 10px rgba(0,0,0,0.2);
        }

        .sidebar-header { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.1rem; margin-bottom: 30px; color: var(--accent); }
        
        .team-tabs { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 5px; margin-bottom: 10px; }
        
        .tab-item { 
            display: flex; justify-content: space-between; align-items: center;
            padding: 12px 15px; border-radius: 10px; cursor: pointer; transition: 0.2s;
            color: var(--muted); font-weight: 600; border: 1px solid transparent;
        }
        .tab-item:hover { background: rgba(255,255,255,0.05); color: var(--text); }
        .tab-item.active { background: rgba(56, 189, 248, 0.1); color: var(--accent); border-color: rgba(56, 189, 248, 0.2); }
        .tab-item .btn-del-team { opacity: 0; transition: 0.2s; color: var(--danger); font-size: 1.2rem; }
        .tab-item:hover .btn-del-team { opacity: 1; }

        .btn-add-team { 
            background: transparent; border: 1px dashed var(--muted); 
            color: var(--muted); padding: 12px; border-radius: 8px; cursor: pointer; width: 100%; transition: 0.2s;
            display: flex; justify-content: center; align-items: center; gap: 8px; font-weight: 600;
        }
        .btn-add-team:hover { border-color: var(--accent); color: var(--accent); background: rgba(56, 189, 248, 0.05); }

        /* --- CONTEÚDO PRINCIPAL --- */
        main { flex: 1; display: flex; flex-direction: column; overflow-y: auto; background: #0b1120; }

        .top-bar { 
            padding: 20px 40px; border-bottom: 1px solid var(--border); background: rgba(15, 23, 42, 0.8);
            display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(12px);
            position: sticky; top: 0; z-index: 5;
        }

        .search-container { display: flex; align-items: center; background: #0f172a; border: 1px solid var(--border); border-radius: 10px; padding: 0 15px; width: 350px; transition: 0.3s; }
        .search-container:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2); }
        .search-container input { border: none; background: transparent; color: white; padding: 12px; width: 100%; outline: none; }
        .search-container i { color: var(--muted); }

        .content-body { padding: 40px; max-width: 1300px; margin: 0 auto; width: 100%; }

        .stats-row { display: flex; gap: 20px; margin-bottom: 30px; }
        .stat-card { background: var(--card); padding: 20px 25px; border-radius: 15px; border: 1px solid var(--border); flex: 1; box-shadow: var(--shadow-sm); }
        .stat-card span { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; font-weight: 700; letter-spacing: 1px; }
        .stat-card h2 { margin: 5px 0 0 0; font-size: 2rem; }

        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px; }

        /* --- CARDS & COMPONENTES --- */
        .card-user { background: var(--card); border-radius: 20px; border: 1px solid var(--border); padding: 20px; cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; }
        .card-user:hover { transform: translateY(-5px); border-color: var(--accent); box-shadow: 0 12px 30px -10px rgba(56, 189, 248, 0.15); }
        .card-user img { width: 100%; height: 240px; border-radius: 15px; object-fit: cover; margin-bottom: 15px; background: #2a3b52; }
        .card-user h3 { margin: 0; font-size: 1.2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .card-user .team-badge { position: absolute; top: 30px; right: 30px; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(4px); color: var(--accent); border: 1px solid var(--accent); font-size: 0.65rem; padding: 4px 10px; border-radius: 20px; font-weight: 800; text-transform: uppercase; }

        /* Estado vazio (Empty State) */
        .empty-state { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; text-align: center; color: var(--muted); background: rgba(255,255,255,0.02); border-radius: 20px; border: 1px dashed var(--border); }
        .empty-state i { font-size: 4rem; margin-bottom: 15px; opacity: 0.5; }
        
        /* Loading Animation */
        .loading-spinner { animation: spin 1s linear infinite; display: inline-block; }
        @keyframes spin { 100% { transform: rotate(360deg); } }

        /* Botões */
        button.primary { background: var(--accent); color: var(--bg); border: none; padding: 12px 25px; border-radius: 10px; font-weight: 700; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 8px; justify-content: center; }
        button.primary:hover { background: var(--accent-hover); transform: scale(1.02); box-shadow: 0 4px 12px rgba(56, 189, 248, 0.3); }
        button.danger { background: var(--danger); color: white; }
        button.danger:hover { background: #dc2626; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3); }
        button.outline { background: transparent; color: var(--text); border: 1px solid var(--muted); }
        button.outline:hover { background: rgba(255,255,255,0.05); }
        
        button.close-btn { background: rgba(255,255,255,0.05); border: 1px solid transparent; color: var(--text); cursor: pointer; font-size: 1.2rem; transition: 0.2s; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; }
        button.close-btn:hover { background: rgba(239, 68, 68, 0.1); color: var(--danger); border-color: rgba(239, 68, 68, 0.3); transform: rotate(90deg); }

        /* Inputs modernos */
        .input-group { background: rgba(0,0,0,0.2); padding: 20px; border-radius: 15px; border-left: 4px solid var(--accent); margin-bottom: 20px; }
        input, select { background: #0f172a; border: 1px solid var(--border); color: white; padding: 14px; border-radius: 8px; width: 100%; font-family: inherit; margin-top: 5px; transition: 0.3s; outline: none; }
        input:focus, select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2); }
        
        /* --- MODAIS --- */
        .modal-overlay { position: fixed; inset: 0; background: rgba(11, 17, 32, 0.85); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 1000; opacity: 0; pointer-events: none; transition: 0.3s; }
        .modal-overlay:not(.hidden) { opacity: 1; pointer-events: all; }
        .modal-box { background: var(--card); border-radius: 20px; border: 1px solid var(--border); width: min(800px, 95%); max-height: 90vh; overflow-y: auto; position: relative; transform: translateY(20px); transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
        .modal-overlay:not(.hidden) .modal-box { transform: translateY(0); }

        .modal-grid { display: grid; grid-template-columns: 320px 1fr; gap: 30px; padding: 40px; }
        @media (max-width: 768px) { .modal-grid { grid-template-columns: 1fr; } .top-bar { flex-direction: column; gap: 15px; } .search-container { width: 100%; } }

        .toast-container { position: fixed; bottom: 20px; right: 20px; z-index: 2000; display: flex; flex-direction: column; gap: 10px; }
        .toast { background: var(--card); border-left: 4px solid var(--success); color: white; padding: 16px 25px; border-radius: 10px; display: flex; align-items: center; gap: 12px; box-shadow: var(--shadow-lg); font-weight: 600; animation: slideIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
        @keyframes slideIn { from { transform: translateX(120%); } to { transform: translateX(0); } }
    </style>
</head>
<body>

    <aside>
        <div class="sidebar-header">
            <div style="background: var(--accent); color: var(--bg); padding: 8px; border-radius: 10px; display: flex;">
                <i class="ph-fill ph-projector-screen-chart"></i>
            </div>
            PROD MANAGER
        </div>
        
        <label style="font-size: 0.75rem; color: var(--muted); text-transform: uppercase; font-weight: 700; margin-bottom: 12px; display: block; letter-spacing: 1px;">Equipes</label>
        
        <div class="team-tabs" id="team-tabs-list"></div>

        <button class="btn-add-team" onclick="abrirModalAddTeam()">
            <i class="ph-bold ph-plus"></i> Nova Equipe
        </button>

        <button class="primary outline" style="margin-top: 20px; width: 100%; border: 1px solid var(--border);" onclick="abrirAdmin()">
            <i class="ph ph-gear"></i> Ajustes de Equipe
        </button>
    </aside>

    <main>
        <div class="top-bar">
            <div class="search-container">
                <i class="ph ph-magnifying-glass"></i>
                <input type="text" id="main-search" placeholder="Buscar na equipe atual..." oninput="renderGrid()">
            </div>
            
            <div style="display: flex; gap: 10px; align-items: center; background: rgba(0,0,0,0.2); padding: 8px 15px; border-radius: 12px; border: 1px solid var(--border);">
                <div style="text-align: right; padding-right: 10px; border-right: 1px solid var(--border);">
                    <div style="color: var(--muted); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.5px;">META / MÉDIA GLOBAL</div>
                    <input type="number" id="global-media" onchange="saveGlobalMedia()" value="0" style="background: transparent; border: none; border-bottom: 1px dashed var(--accent); color: var(--accent); font-size: 1.3rem; font-weight: 800; width: 80px; text-align: right; outline: none; padding: 0; margin: 0; box-shadow: none;">
                </div>
                
                <button class="primary outline" style="padding: 10px; border-radius: 10px; border-color: var(--border); width: 45px; height: 45px;" onclick="abrirModalConfigApi()" title="Vincular Integrações (APIs)">
                    <i class="ph-bold ph-link" style="font-size: 1.3rem; color: var(--muted);"></i>
                </button>
            </div>
        </div>

        <div class="content-body">
            <div class="stats-row">
                <div class="stat-card">
                    <span><i class="ph-fill ph-users" style="color: var(--accent); margin-right: 5px;"></i> Membros Exibidos</span>
                    <h2 id="stats-members">0</h2>
                </div>
            </div>

            <div class="grid" id="users-grid"></div>
        </div>
    </main>

    <div id="modal-config-api" class="modal-overlay hidden">
        <div class="modal-box" style="max-width: 450px;">
            <div style="padding: 30px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 25px;">
                    <h2 style="margin:0; display: flex; align-items: center; gap: 10px;"><i class="ph-fill ph-link" style="color: var(--accent);"></i> Vincular Integrações</h2>
                    <button class="close-btn" onclick="fecharModalConfigApi()"><i class="ph ph-x"></i></button>
                </div>

                <div class="input-group">
                    <label style="font-size: 0.85rem; color: var(--muted); font-weight: 600;">URL do Google Sheets (Quantidades)</label>
                    <input type="text" id="api-url-input" placeholder="Cole a URL gerada pelo Google Sheets aqui..." style="margin-bottom: 15px;">

                    <label style="font-size: 0.85rem; color: var(--muted); font-weight: 600;">URL do Clockify (Tempo)</label>
                    <input type="text" id="api-clockify-url-input" placeholder="Cole a URL do Clockify aqui..." onkeypress="if(event.key === 'Enter') salvarConfigApi()">

                    <p style="font-size: 0.75rem; color: var(--muted); margin-top: 15px;">
                        <i class="ph-fill ph-info"></i> O sistema utilizará esses links para puxar as quantidades e os tempos de forma automática.
                    </p>
                    <button class="primary" style="width: 100%; margin-top: 20px;" onclick="salvarConfigApi()">
                        <i class="ph-bold ph-floppy-disk"></i> Salvar Vínculos
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="modal-confirm" class="modal-overlay hidden" style="z-index: 3000;">
        <div class="modal-box" style="max-width: 400px; text-align: center; padding: 40px 30px;">
            <div id="confirm-icon" style="background: rgba(239, 68, 68, 0.1); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto;">
                <i class="ph-fill ph-warning-circle" style="font-size: 3rem; color: var(--danger);"></i>
            </div>
            <h2 id="confirm-title" style="margin: 0 0 10px 0; font-size: 1.5rem;">Atenção</h2>
            <p id="confirm-message" style="color: var(--muted); margin: 0 0 30px 0; line-height: 1.5;"></p>
            <div style="display: flex; gap: 15px; justify-content: center;">
                <button class="primary outline" onclick="fecharConfirm()" style="flex: 1;">Cancelar</button>
                <button class="primary danger" id="btn-confirm-action" style="flex: 1;">Sim, excluir</button>
            </div>
        </div>
    </div>

    <div id="modal-add-team" class="modal-overlay hidden">
        <div class="modal-box" style="max-width: 450px;">
            <div style="padding: 30px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 25px;">
                    <h2 style="margin:0; display: flex; align-items: center; gap: 10px;"><i class="ph-fill ph-users-three" style="color: var(--accent);"></i> Nova Equipe</h2>
                    <button class="close-btn" onclick="fecharModalAddTeam()"><i class="ph ph-x"></i></button>
                </div>

                <div class="input-group">
                    <label style="font-size: 0.85rem; color: var(--muted); font-weight: 600;">Nome da Equipe</label>
                    <input type="text" id="new-team-input" placeholder="Ex: Equipe de Vendas, Suporte..." onkeypress="if(event.key === 'Enter') confirmarAddTeam()">
                    <button class="primary" style="width: 100%; margin-top: 20px;" onclick="confirmarAddTeam()">
                        <i class="ph-bold ph-check"></i> Criar Equipe
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="modal-admin" class="modal-overlay hidden">
        <div class="modal-box" style="max-width: 550px;">
            <div style="padding: 35px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 30px;">
                    <h2 style="margin:0; display: flex; align-items: center; gap: 10px;"><i class="ph-fill ph-gear" style="color: var(--accent);"></i> Gerenciar Pessoas</h2>
                    <button class="close-btn" onclick="fecharAdmin()"><i class="ph ph-x"></i></button>
                </div>

                <div class="input-group" style="border-left-color: var(--success); background: rgba(16, 185, 129, 0.05);">
                    <label style="font-size: 0.85rem; color: var(--muted); font-weight: 600;">Cadastrar Novo Integrante</label>
                    <div style="display: flex; gap: 10px; margin-top: 5px;">
                        <input type="text" id="new-user-name" placeholder="Digite o nome completo" onkeypress="if(event.key === 'Enter') addUser()">
                        <button class="primary" style="background: var(--success); padding: 0 20px; width: auto;" onclick="addUser()">
                            <i class="ph-bold ph-plus"></i>
                        </button>
                    </div>
                    <p style="font-size: 0.75rem; color: var(--muted); margin-top: 10px; display: flex; align-items: center; gap: 5px;">
                        <i class="ph-fill ph-info"></i> O membro será adicionado na aba que estiver selecionada ao fundo.
                    </p>
                </div>

                <h4 style="color: var(--muted); border-bottom: 1px solid var(--border); padding-bottom: 10px; margin-top: 30px;">Lista de Membros (Todas as Equipes)</h4>
                <div id="admin-users-list" style="max-height: 250px; overflow-y: auto; padding-right: 10px;"></div>
            </div>
        </div>
    </div>

    <div id="modal-user" class="modal-overlay hidden">
        <div class="modal-box">
            <button class="close-btn" style="top: 25px; right: 25px; position: absolute; z-index: 10;" onclick="fecharModal()"><i class="ph ph-x"></i></button>
            <div class="modal-grid">
                
                <div style="text-align: center;">
                    <img src="" id="m-avatar" style="width: 100%; max-width: 250px; border-radius: 20px; box-shadow: var(--shadow-lg); margin-bottom: 15px;">
                    <h2 id="m-name" style="margin: 0; font-size: 1.5rem;">Nome</h2>
                    <div id="m-team-label" style="color: var(--accent); font-weight: 800; font-size: 0.8rem; text-transform: uppercase; margin-top: 5px;">EQUIPE</div>
                </div>
                
                <div>
                    <h3 style="margin-top: 0; border-bottom: 1px solid var(--border); padding-bottom: 15px; margin-bottom: 20px;"><i class="ph-fill ph-clipboard-text"></i> Registro de Produção</h3>
                    <div class="input-group">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div>
                                <label style="font-size: 0.85rem; color: var(--muted); font-weight: 600;">Qtd. na Planilha</label>
                                <div style="position: relative;">
                                    <input type="text" id="input-qtd" readonly style="opacity: 0.7; cursor: not-allowed; padding-left: 40px; font-weight: bold;">
                                    <i id="qtd-icon" class="ph ph-google-logo" style="position: absolute; left: 12px; top: 18px; color: var(--accent); font-size: 1.2rem;"></i>
                                </div>
                            </div>
                            <div>
                                <label style="font-size: 0.85rem; color: var(--muted); font-weight: 600;">Tempo Gasto</label>
                                <input type="time" id="input-time" oninput="calcMedia()" style="font-weight: bold;">
                            </div>
                        </div>
                        
                        <div style="margin-top: 25px; padding: 20px; background: rgba(0,0,0,0.4); border-radius: 12px; text-align: center; border: 1px solid var(--border);">
                            <span style="color: var(--muted); font-size: 0.75rem; font-weight: 800; letter-spacing: 1px;">MÉDIA CALCULADA</span>
                            <div id="m-media" style="font-size: 2rem; font-weight: 800; color: var(--success); margin-top: 5px;">0.00 <span style="font-size: 1rem; color: var(--muted);">/h</span></div>
                        </div>
                        
                        <button class="primary" style="width: 100%; margin-top: 20px; padding: 15px; font-size: 1.1rem;" onclick="saveAct()">
                            <i class="ph-bold ph-floppy-disk"></i> Salvar no Histórico
                        </button>
                    </div>

                    <h4 style="color: var(--muted); margin-bottom: 10px; font-size: 0.9rem;">Últimos Registros Salvos</h4>
                    <div id="m-history" style="max-height: 180px; overflow-y: auto; padding-right: 5px;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-container" id="toasts"></div>

    <script>
        // --- BANCO DE DADOS LOCAL ---
        let teams = JSON.parse(localStorage.getItem('prod_teams_v1')) || [
            { id: 'all', name: 'Todas as Equipes' },
            { id: 'clt', name: 'Equipe CLT' },
            { id: 'estagio', name: 'Estagiários' }
        ];

        let users = JSON.parse(localStorage.getItem('prod_users_v1')) || [];
        let activities = JSON.parse(localStorage.getItem('prod_acts_v1')) || [];
        let globalMediaValue = localStorage.getItem('prod_global_media_v1') || 0;
        
        // VARIÁVEIS DAS URLs DAS APIs
        let apiPlanilhaUrl = localStorage.getItem('prod_api_url_v1') || "";
        let apiClockifyUrl = localStorage.getItem('prod_clockify_url_v1') || ""; // NOVO CAMPO CLOCKIFY
        
        let currentTab = 'all';
        let selectedUser = null;

        window.onload = () => {
            document.getElementById('global-media').value = globalMediaValue;
            renderTabs();
            renderGrid();
        };

        function saveGlobalMedia() {
            globalMediaValue = document.getElementById('global-media').value;
            localStorage.setItem('prod_global_media_v1', globalMediaValue);
            showToast("Meta atualizada com sucesso!");
        }

        // --- FUNÇÕES DA CONFIGURAÇÃO DE API ---
        function abrirModalConfigApi() {
            const inputSheets = document.getElementById('api-url-input');
            const inputClockify = document.getElementById('api-clockify-url-input');
            
            inputSheets.value = apiPlanilhaUrl;
            inputClockify.value = apiClockifyUrl;
            
            document.getElementById('modal-config-api').classList.remove('hidden');
            setTimeout(() => inputSheets.focus(), 100);
        }

        function fecharModalConfigApi() {
            document.getElementById('modal-config-api').classList.add('hidden');
        }

        function salvarConfigApi() {
            apiPlanilhaUrl = document.getElementById('api-url-input').value.trim();
            apiClockifyUrl = document.getElementById('api-clockify-url-input').value.trim();
            
            localStorage.setItem('prod_api_url_v1', apiPlanilhaUrl);
            localStorage.setItem('prod_clockify_url_v1', apiClockifyUrl);
            
            fecharModalConfigApi();
            showToast("Vínculos das APIs salvos com sucesso!");
        }

        // --- SISTEMA DE CONFIRMAÇÃO CUSTOMIZADO (UX PROFISSIONAL) ---
        let confirmActionCallback = null;
        function abrirConfirm(titulo, mensagem, callback) {
            document.getElementById('confirm-title').innerText = titulo;
            document.getElementById('confirm-message').innerText = mensagem;
            confirmActionCallback = callback;
            document.getElementById('modal-confirm').classList.remove('hidden');
        }
        function fecharConfirm() {
            document.getElementById('modal-confirm').classList.add('hidden');
            confirmActionCallback = null;
        }
        document.getElementById('btn-confirm-action').onclick = () => {
            if (confirmActionCallback) confirmActionCallback();
            fecharConfirm();
        };

        // --- GESTÃO DE EQUIPES (ABAS) ---
        function renderTabs() {
            const list = document.getElementById('team-tabs-list');
            list.innerHTML = '';
            teams.forEach(t => {
                const isActive = currentTab === t.id ? 'active' : '';
                list.innerHTML += `
                    <div class="tab-item ${isActive}" onclick="selectTab('${t.id}')">
                        <span style="display: flex; align-items: center; gap: 8px;">
                            <i class="${t.id === 'all' ? 'ph-fill ph-users' : 'ph-fill ph-folder'}"></i>
                            ${t.name}
                        </span>
                        ${t.id !== 'all' ? `<i class="ph-fill ph-trash btn-del-team" title="Excluir equipe" onclick="deleteTeam(event, '${t.id}', '${t.name}')"></i>` : ''}
                    </div>
                `;
            });
        }

        function selectTab(id) {
            currentTab = id;
            renderTabs();
            renderGrid();
        }

        function abrirModalAddTeam() {
            const input = document.getElementById('new-team-input');
            input.value = '';
            document.getElementById('modal-add-team').classList.remove('hidden');
            setTimeout(() => input.focus(), 100); 
        }

        function fecharModalAddTeam() {
            document.getElementById('modal-add-team').classList.add('hidden');
        }

        function confirmarAddTeam() {
            const name = document.getElementById('new-team-input').value.trim();
            if (name) {
                const id = 'team_' + Date.now();
                teams.push({ id, name });
                saveTeams();
                renderTabs();
                fecharModalAddTeam();
                showToast(`Equipe "${name}" criada com sucesso!`);
            } else {
                showToast("Digite um nome válido para a equipe!", "error");
            }
        }

        function deleteTeam(e, id, teamName) {
            e.stopPropagation(); 
            abrirConfirm(
                "Excluir Equipe?", 
                `Tem certeza que deseja apagar a equipe "${teamName}"? Os membros não serão apagados, apenas ficarão "Sem Equipe".`, 
                () => {
                    teams = teams.filter(t => t.id !== id);
                    if (currentTab === id) currentTab = 'all';
                    saveTeams();
                    renderTabs();
                    renderGrid();
                    showToast("Equipe removida.");
                }
            );
        }

        function saveTeams() { localStorage.setItem('prod_teams_v1', JSON.stringify(teams)); }

        // --- GESTÃO DE MEMBROS ---
        function renderGrid() {
            const grid = document.getElementById('users-grid');
            const term = document.getElementById('main-search').value.toLowerCase();
            grid.innerHTML = '';

            let filtered = users;
            if (currentTab !== 'all') filtered = filtered.filter(u => u.teamId === currentTab);
            if (term) filtered = filtered.filter(u => u.name.toLowerCase().includes(term));

            // ESTADO VAZIO
            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="empty-state">
                        <i class="ph-duotone ph-users-slash"></i>
                        <h3 style="margin: 0 0 10px 0;">Nenhum membro encontrado</h3>
                        <p style="margin: 0; font-size: 0.9rem;">Adicione pessoas usando o botão "Ajustes de Equipe" na barra lateral.</p>
                    </div>
                `;
            } else {
                filtered.forEach(u => {
                    const uActs = activities.filter(a => a.userId === u.id);
                    const uQtd = uActs.reduce((acc, c) => acc + c.qtd, 0);
                    const uMin = uActs.reduce((acc, c) => acc + timeToMin(c.time), 0);

                    const teamName = teams.find(t => t.id === u.teamId)?.name || 'Sem Equipe';

                    grid.innerHTML += `
                        <div class="card-user" onclick="openUserModal(${u.id})">
                            <div class="team-badge">${teamName}</div>
                            <img src="${u.avatar}" loading="lazy">
                            <h3>${u.name}</h3>
                            <div class="tags" style="margin-top: 15px; display: flex; gap: 10px; border-top: 1px solid var(--border); padding-top: 15px;">
                                <span class="tag" style="font-size: 0.85rem; color: var(--muted); font-weight: 600; flex: 1;"><i class="ph-fill ph-clock" style="color: var(--accent)"></i> ${minToTime(uMin)}</span>
                                <span class="tag" style="font-size: 0.85rem; color: var(--muted); font-weight: 600; flex: 1;"><i class="ph-fill ph-package" style="color: var(--success)"></i> ${uQtd} un.</span>
                            </div>
                        </div>
                    `;
                });
            }

            document.getElementById('stats-members').innerText = filtered.length;
        }

        function addUser() {
            const name = document.getElementById('new-user-name').value.trim();
            if (!name) {
                return showToast("Digite um nome para o integrante.", "error");
            }
            
            const newUser = {
                id: Date.now(),
                name: name,
                teamId: currentTab === 'all' ? (teams[1]?.id || 'all') : currentTab,
                avatar: `https://ui-avatars.com/api/?name=${name}&background=38bdf8&color=fff&size=512&font-size=0.33`
            };

            users.push(newUser);
            localStorage.setItem('prod_users_v1', JSON.stringify(users));
            document.getElementById('new-user-name').value = '';
            renderGrid();
            renderAdminUsers();
            showToast(`${name} adicionado(a) com sucesso!`);
        }

        // --- MODAL USUÁRIO COM API ---
        function openUserModal(id) {
            selectedUser = users.find(u => u.id === id);
            document.getElementById('modal-user').classList.remove('hidden');
            document.getElementById('m-name').innerText = selectedUser.name;
            document.getElementById('m-avatar').src = selectedUser.avatar;
            document.getElementById('m-team-label').innerText = teams.find(t => t.id === selectedUser.teamId)?.name || 'Sem Equipe';
            
            // Reseta os campos
            document.getElementById('input-time').value = '';
            document.getElementById('m-media').innerHTML = '0.00 <span style="font-size: 1rem; color: var(--muted);">/h</span>';
            updateHistory();

            const inputQtd = document.getElementById('input-qtd');
            const iconQtd = document.getElementById('qtd-icon');
            
            // --- LÓGICA DE QUANTIDADE (Planilha) ---
            if (!apiPlanilhaUrl) {
                inputQtd.type = "text";
                inputQtd.value = "Sem Vínculo";
                iconQtd.className = "ph-fill ph-warning-circle";
                iconQtd.style.color = "var(--danger)";
            } else {
                inputQtd.type = "text"; 
                inputQtd.value = "Sincronizando...";
                iconQtd.className = "ph ph-spinner-gap loading-spinner";
                
                fetch(`${apiPlanilhaUrl}?nome=${encodeURIComponent(selectedUser.name)}`)
                    .then(response => response.json())
                    .then(data => {
                        inputQtd.type = "number"; 
                        inputQtd.value = data.qtd || 0; 
                        iconQtd.className = "ph-fill ph-check-circle";
                        iconQtd.style.color = "var(--success)";
                        calcMedia();
                    })
                    .catch(error => {
                        inputQtd.value = 0;
                    });
            }

            // --- LÓGICA CLOCKIFY (TEMPO) ---
            const inputTime = document.getElementById('input-time');
            inputTime.value = ""; 
            
            if (apiClockifyUrl) {
                fetch(apiClockifyUrl)
                    .then(res => res.json())
                    .then(dataClockify => {
                        const userTime = dataClockify.find(d => d.nome.toLowerCase() === selectedUser.name.toLowerCase());
                        
                        if (userTime) {
                            inputTime.value = userTime.tempo; 
                            calcMedia(); 
                            showToast(`Tempo de ${userTime.tempo} puxado do Clockify!`, 'success');
                        } else {
                            showToast(`Nenhum tempo cronometrado hoje para ${selectedUser.name}.`, 'error');
                        }
                    })
                    .catch(err => {
                        console.error("Erro Clockify:", err);
                        showToast("Falha ao puxar dados do Clockify.", "error");
                    });
            }
        }

        function saveAct() {
            const time = document.getElementById('input-time').value;
            const qtd = Number(document.getElementById('input-qtd').value);

            if(!time) return showToast("Por favor, preencha o tempo gasto!", "error");

            activities.push({
                id: Date.now(),
                userId: selectedUser.id,
                qtd,
                time,
                date: new Date().toLocaleDateString('pt-BR', {day: '2-digit', month: 'short'})
            });

            localStorage.setItem('prod_acts_v1', JSON.stringify(activities));
            updateHistory();
            renderGrid();
            document.getElementById('input-time').value = ''; 
            showToast("Produção registrada com sucesso!");
        }

        function deleteAct(actId) {
            abrirConfirm("Apagar Registro", "Deseja remover esta produção do histórico do usuário? Isso afetará os cálculos totais.", () => {
                activities = activities.filter(a => a.id !== actId);
                localStorage.setItem('prod_acts_v1', JSON.stringify(activities));
                updateHistory();
                renderGrid();
                showToast("Registro apagado.");
            });
        }

        // --- AUXILIARES ---
        function timeToMin(t) { 
            if(!t) return 0; 
            const p = t.split(':').map(Number); 
            return (p[0] * 60) + p[1]; 
        }
        
        function minToTime(m) { 
            const h = Math.floor(m / 60); 
            const mn = m % 60; 
            return `${String(h).padStart(2,'0')}h${String(mn).padStart(2,'0')}`; 
        }

        function calcMedia() {
            const t = document.getElementById('input-time').value;
            const q = Number(document.getElementById('input-qtd').value);
            const mediaBox = document.getElementById('m-media');
            
            if(t) {
                const p = t.split(':').map(Number);
                const dec = p[0] + (p[1]/60);
                if (dec > 0) {
                    const result = (q/dec).toFixed(2);
                    mediaBox.innerHTML = `${result} <span style="font-size: 1rem; color: var(--muted);">/h</span>`;
                    mediaBox.style.color = "var(--success)";
                } else {
                    mediaBox.innerHTML = `0.00 <span style="font-size: 1rem; color: var(--muted);">/h</span>`;
                }
            }
        }

        function updateHistory() {
            const hist = document.getElementById('m-history');
            const uActs = activities.filter(a => a.userId === selectedUser.id);
            
            if (uActs.length === 0) {
                hist.innerHTML = `
                    <div style="color: var(--muted); font-size: 0.85rem; text-align: center; padding: 20px; background: rgba(0,0,0,0.1); border-radius: 10px; border: 1px dashed var(--border);">
                        Nenhum registro no histórico.
                    </div>`;
                return;
            }

            hist.innerHTML = uActs.reverse().map(a => `
                <div style="background: rgba(255,255,255,0.03); padding: 12px 15px; border-radius: 10px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem; transition: 0.2s; border: 1px solid transparent;" onmouseover="this.style.borderColor='var(--border)'" onmouseout="this.style.borderColor='transparent'">
                    <span style="display: flex; gap: 15px;">
                        <b style="color: var(--text);">${a.date}</b> 
                        <span style="color: var(--muted);"><i class="ph-fill ph-clock"></i> ${a.time}</span>
                    </span>
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <span style="background: rgba(16, 185, 129, 0.1); color: var(--success); padding: 4px 10px; border-radius: 20px; font-weight: bold; font-size: 0.8rem;">${a.qtd} un.</span>
                        <button onclick="deleteAct(${a.id})" style="background: none; border: none; color: var(--danger); cursor: pointer; padding: 5px; border-radius: 5px; display: flex; transition: 0.2s;" onmouseover="this.style.background='rgba(239, 68, 68, 0.1)'" onmouseout="this.style.background='none'" title="Apagar registro">
                            <i class="ph-fill ph-trash"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function showToast(msg, type = 'success') {
            const c = document.getElementById('toasts');
            const t = document.createElement('div');
            t.className = 'toast';
            if(type === 'error') {
                t.style.borderLeftColor = 'var(--danger)';
                t.innerHTML = `<i class="ph-fill ph-warning-circle" style="color: var(--danger); font-size: 1.2rem;"></i> ${msg}`;
            } else {
                t.innerHTML = `<i class="ph-fill ph-check-circle" style="color: var(--success); font-size: 1.2rem;"></i> ${msg}`;
            }
            c.appendChild(t);
            setTimeout(() => {
                t.style.animation = 'slideIn 0.4s reverse forwards';
                setTimeout(() => t.remove(), 400);
            }, 3000);
        }

        function abrirAdmin() { 
            document.getElementById('modal-admin').classList.remove('hidden'); 
            renderAdminUsers();
        }
        function fecharAdmin() { document.getElementById('modal-admin').classList.add('hidden'); }
        function fecharModal() { document.getElementById('modal-user').classList.add('hidden'); }

        function renderAdminUsers() {
            const list = document.getElementById('admin-users-list');
            if (users.length === 0) {
                list.innerHTML = `<p style="color: var(--muted); text-align: center; margin-top: 20px;">Não há membros cadastrados ainda.</p>`;
                return;
            }
            list.innerHTML = users.map(u => {
                const teamName = teams.find(t => t.id === u.teamId)?.name || 'Sem Equipe';
                return `
                <div style="display: flex; justify-content: space-between; align-items:center; padding: 12px; border-bottom: 1px solid var(--border); transition: 0.2s;">
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.95rem; font-weight: 600;">${u.name}</span>
                        <span style="font-size: 0.75rem; color: var(--accent);">${teamName}</span>
                    </div>
                    <button onclick="delUser(${u.id}, '${u.name}')" style="background:none; border:none; color: var(--muted); cursor:pointer; padding: 8px; border-radius: 8px; transition: 0.2s;" onmouseover="this.style.color='var(--danger)'; this.style.background='rgba(239, 68, 68, 0.1)';" onmouseout="this.style.color='var(--muted)'; this.style.background='none';">
                        <i class="ph-fill ph-trash" style="font-size: 1.1rem;"></i>
                    </button>
                </div>
            `}).join('');
        }

        function delUser(id, userName) {
            abrirConfirm("Excluir Membro", `Tem certeza que deseja remover permanentemente o(a) membro "${userName}"? Todos os registros dele(a) serão mantidos no histórico local (se precisar deles para auditoria), mas o perfil sumirá da tela.`, () => {
                users = users.filter(u => u.id !== id);
                localStorage.setItem('prod_users_v1', JSON.stringify(users));
                renderGrid();
                renderAdminUsers();
                showToast("Membro removido.");
            });
        }
    </script>
</body>
</html>
