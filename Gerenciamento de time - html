<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Produção Pro - Equipes</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    
    <!-- Flatpickr (Para pequenos modais de data) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/dark.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/pt.js"></script>
    
    <!-- Ficheiro CSS Externo -->
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <aside>
        <div class="sidebar-header">
            <div style="background: var(--accent); color: var(--bg); padding: 8px; border-radius: 10px; display: flex;">
                <i class="ph-fill ph-projector-screen-chart"></i>
            </div>
            PROD MANAGER
        </div>
        
        <label style="font-size: 0.75rem; color: var(--muted); text-transform: uppercase; font-weight: 700; margin-bottom: 12px; display: block; letter-spacing: 1px;">Equipes</label>
        
        <div class="team-tabs" id="team-tabs-list"></div>

        <button class="btn-add-team" id="btn-add-team-sidebar" onclick="abrirModalAddTeam()">
            <i class="ph-bold ph-plus"></i> Nova Equipe
        </button>

        <button class="primary outline" style="margin-top: 20px; width: 100%; border: 1px solid var(--border);" onclick="abrirAdmin()">
            <i class="ph ph-gear"></i> Ajustes Globais
        </button>
    </aside>

    <main style="position: relative;">
        <div class="top-bar">
            <!-- GRUPO DE FILTROS DO ADMIN -->
            <div id="admin-top-controls" style="display: flex; gap: 15px; flex: 1; align-items: center; flex-wrap: wrap;">
                
                <div class="search-container" style="max-width: 300px; width: 100%;">
                    <i class="ph ph-magnifying-glass"></i>
                    <input type="text" id="main-search" placeholder="Buscar na equipe..." oninput="renderGrid()">
                </div>
                
                <select id="filter-period" onchange="renderGrid()" style="display: none;">
                    <option value="today">Hoje</option>
                    <option value="yesterday">Ontem</option>
                    <option value="week" selected>Esta Semana</option>
                    <option value="last_week">Semana Passada</option>
                    <option value="month">Este Mês</option>
                    <option value="all">Todo o Período</option>
                </select>
                
                <div style="display: flex; gap: 5px; background: rgba(0,0,0,0.2); padding: 5px; border-radius: 12px; border: 1px solid var(--border);">
                    <button id="btn-view-grid" onclick="switchView('grid')" class="primary" style="padding: 8px 15px; border-radius: 8px; font-size: 0.85rem; width: auto;">
                        <i class="ph-bold ph-squares-four"></i> Cards
                    </button>
                    <!-- GRÁFICOS AGORA VISÍVEIS -->
                    <button id="btn-view-charts" onclick="switchView('charts')" class="primary outline" style="padding: 8px 15px; border-radius: 8px; font-size: 0.85rem; width: auto; border: none;">
                        <i class="ph-bold ph-chart-bar"></i> Gráficos
                    </button>
                </div>
            </div>

            <!-- ESPAÇADOR PARA FUNCIONÁRIOS -->
            <div id="spacer-top-controls" style="flex: 1; display: none;">
                <h2 style="margin: 0; color: var(--text); display: flex; align-items: center; gap: 10px;">
                    <i class="ph-duotone ph-briefcase" style="color: var(--accent);"></i> Meu Espaço de Trabalho
                </h2>
            </div>
            
            <div style="display: flex; gap: 20px; align-items: center; background: rgba(0,0,0,0.2); padding: 8px 15px; border-radius: 12px; border: 1px solid var(--border);">
                <div style="display: flex; gap: 10px;">
                    <button id="btn-meu-painel" class="primary" style="padding: 10px 15px; border-radius: 10px; cursor: pointer; display: flex; align-items: center; gap: 8px;" onclick="selecionarMeuUsuario()" data-tooltip="Acessar Meu Perfil">
                        <i class="ph-bold ph-user" style="font-size: 1.1rem;"></i> Entrar
                    </button>
                    
                    <button class="primary outline" style="padding: 10px; border-radius: 10px; border-color: var(--border); width: 45px; height: 45px; cursor: pointer;" onclick="toggleTheme()" data-tooltip="Alternar Tema">
                        <i class="ph-fill ph-moon" id="theme-icon" style="font-size: 1.3rem; color: var(--muted); transition: 0.3s;"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- BARRA DO CRONÓMETRO NO TOPO -->
        <div id="native-time-tracker" style="display: none; position: sticky; top: 90px; margin: 20px auto 0 auto; width: 90%; max-width: 1100px; background: rgba(0,0,0,0.85); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 15px 25px; box-shadow: 0 15px 40px rgba(0,0,0,0.6); z-index: 4; align-items: center; justify-content: space-between;">
            
            <div style="display: flex; align-items: center; gap: 20px; flex: 1;">
                
                <!-- MENU SUSPENSO PERSONALIZADO: TAREFA -->
                <div style="display: flex; flex-direction: column; flex: 1; position: relative;">
                    <label style="font-size: 0.65rem; color: var(--muted); font-weight: bold; text-transform: uppercase; margin-bottom: 5px;">Em que você está trabalhando?</label>
                    <div class="custom-select" onclick="toggleCustomDropdown('dropdown-tarefa', event)">
                        <span id="display-tarefa" style="font-size: 0.95rem; font-weight: bold; color: var(--text);">Selecione uma tarefa...</span>
                        <i class="ph-bold ph-caret-down" style="color: var(--muted);"></i>
                    </div>
                    <div class="custom-options-menu hidden" id="dropdown-tarefa"></div>
                    <!-- Input oculto para gravar a lógica -->
                    <input type="hidden" id="tracker-descricao" onchange="onTrackerFieldChanged()">
                </div>

                <div style="width: 1px; height: 30px; background: var(--border);"></div>

                <!-- MENU SUSPENSO PERSONALIZADO: CATEGORIA -->
                <div style="display: flex; flex-direction: column; width: 250px; position: relative;">
                    <label style="font-size: 0.65rem; color: var(--muted); font-weight: bold; text-transform: uppercase; margin-bottom: 5px;">Categoria (Opcional)</label>
                    <div class="custom-select" onclick="toggleCustomDropdown('dropdown-atividade', event)">
                        <span id="display-atividade" style="font-size: 0.85rem; font-weight: bold; color: var(--accent);">Nenhuma...</span>
                        <i class="ph-bold ph-caret-down" style="color: var(--muted);"></i>
                    </div>
                    <div class="custom-options-menu hidden" id="dropdown-atividade"></div>
                    <!-- Input oculto para gravar a lógica -->
                    <input type="hidden" id="tracker-atividade" onchange="onTrackerFieldChanged()">
                </div>

            </div>

            <div style="display: flex; align-items: center; gap: 20px; border-left: 1px solid var(--border); padding-left: 20px;">
                <div id="tracker-display" style="font-size: 1.5rem; font-weight: 800; color: var(--text); font-family: monospace; letter-spacing: 2px;">
                    00:00:00
                </div>

                <button id="btn-tracker-play" class="primary" style="background: var(--success); border-radius: 8px; padding: 10px 20px; display: flex; align-items: center; gap: 8px; text-transform: uppercase; font-size: 0.85rem;" onclick="toggleTracker()">
                    <span id="tracker-text-btn">Iniciar</span>
                    <i class="ph-fill ph-play" style="font-size: 1.2rem;" id="tracker-icon"></i>
                </button>
            </div>
        </div>

        <div class="content-body">
            
            <div id="view-employee-dashboard" class="hidden" style="max-width: 1100px; margin: 0 auto; background: var(--card); padding: 30px; border-radius: 20px; box-shadow: var(--shadow-sm); border: 1px solid var(--border);">
                <!-- Cabeçalho da Folha de Horas com Filtros Dinâmicos -->
                <div style="display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 1px solid var(--border); padding-bottom: 15px; margin-bottom: 10px; flex-wrap: wrap; gap: 15px;">
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <h2 style="margin: 0; display: flex; align-items: center; gap: 10px; color: var(--text);">
                            <i class="ph-duotone ph-list-dashes" style="color: var(--accent); font-size: 2rem;"></i> 
                            Folha de Horas
                        </h2>
                        <!-- Botão Data Passada -->
                        <div style="position: relative;">
                            <input type="date" id="main-history-date-filter" onchange="refreshActiveHistories()" class="native-select" style="padding: 8px 12px; height: 35px;">
                        </div>
                    </div>
                </div>
                <div id="main-historico-livre"></div>
            </div>

            <!-- VISÃO ADMIN: GRID DE CARTÕES -->
            <div id="view-grid-container">
                <div class="stats-row">
                    <div class="stat-card">
                        <span><i class="ph-fill ph-users" style="color: var(--accent); margin-right: 5px;"></i> Membros Exibidos</span>
                        <h2 id="stats-members">0</h2>
                    </div>
                </div>
                <div class="grid" id="users-grid"></div>
            </div>

            <!-- VISÃO ADMIN: GRÁFICOS (APENAS HORAS) -->
            <div id="view-charts-container" class="hidden">
                <div style="background: rgba(0,0,0,0.2); padding: 15px 20px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 20px; display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
                    
                    <div style="display: flex; align-items: center; gap: 10px; border-right: 1px solid var(--border); padding-right: 15px;">
                        <i class="ph-bold ph-funnel" style="color: var(--muted);"></i>
                        <select id="chart-mode" class="native-select" onchange="window.renderCharts()" style="min-width: 150px; padding: 10px;">
                            <option value="members">Por Pessoas</option>
                            <option value="teams">Por Equipes</option>
                        </select>
                        <input type="text" id="chart-search" placeholder="Pesquisar nome..." oninput="window.renderCharts()" style="padding: 10px; border-radius: 8px; border: 1px solid var(--border); background: rgba(255,255,255,0.05); color: var(--text); outline: none; width: 160px; font-size: 0.85rem;">
                    </div>

                    <div style="display: flex; align-items: center; gap: 10px;">
                        <select id="chart-period-preset" class="native-select" onchange="applyChartPreset()" style="min-width: 150px; padding: 10px;">
                            <option value="all">Todo o Período</option>
                            <option value="today">Hoje</option>
                            <option value="yesterday">Ontem</option>
                            <option value="week" selected>Esta Semana</option>
                            <option value="last_week">Semana Passada</option>
                            <option value="month">Este Mês</option>
                            <option value="custom">📅 Personalizado...</option>
                        </select>

                        <input type="date" id="chart-date-start" onchange="clearChartPreset()" class="native-select" style="padding: 10px; height: auto;">
                        <span style="color: var(--muted); font-size: 0.9rem;">até</span>
                        <input type="date" id="chart-date-end" onchange="clearChartPreset()" class="native-select" style="padding: 10px; height: auto;">
                        <button class="primary outline" onclick="limparFiltroData()" style="padding: 10px 15px; border-color: var(--border); font-size: 0.85rem;">Limpar</button>
                        
                        <button class="primary" onclick="exportarDadosCSV()" style="padding: 10px 15px; background: #10b981; border: none; font-size: 0.85rem; display: flex; align-items: center; gap: 6px;" data-tooltip="Baixar relatório de horas">
                            <i class="ph-bold ph-download-simple"></i> Excel/CSV
                        </button>
                    </div>
                </div>
                
                <div style="background: rgba(0,0,0,0.2); padding: 20px; border-radius: 12px; border: 1px solid var(--border); box-shadow: var(--shadow-sm); position: relative; height: 400px; width: 100%;">
                    <canvas id="teamChart"></canvas>
                </div>
            </div>
        </div>
    </main>

    <!-- MODAL DO USUÁRIO E HISTÓRICO (APENAS HORAS) -->
    <div id="modal-user" class="modal-overlay hidden">
        <div class="modal-box" style="max-width: 900px;">
            <button class="close-btn" style="top: 25px; right: 25px; position: absolute; z-index: 10;" onclick="fecharModal()"><i class="ph ph-x"></i></button>
            <div class="modal-grid" style="grid-template-columns: 250px 1fr;">
                
                <div style="text-align: center; border-right: 1px solid var(--border); padding-right: 20px;">
                    <img src="" id="m-avatar" style="width: 100%; max-width: 200px; border-radius: 20px; box-shadow: var(--shadow-lg); margin-bottom: 15px;">
                    <h2 id="m-name" style="margin: 0; font-size: 1.5rem;">Nome</h2>
                    <div id="m-team-label" style="color: var(--accent); font-weight: 800; font-size: 0.8rem; text-transform: uppercase; margin-top: 5px;">EQUIPE</div>
                </div>
                
                <div style="position: relative;">
                    <div id="bloco-modal-livre" style="padding-bottom: 20px;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 1px solid var(--border); padding-bottom: 10px; margin-bottom: 15px;">
                            <div>
                                <h3 style="margin: 0 0 5px 0; display: flex; align-items: center; gap: 10px;"><i class="ph-duotone ph-list-dashes" style="color: var(--accent); font-size: 1.5rem;"></i> Folha de Horas</h3>
                                <p style="color: var(--muted); font-size: 0.85rem; margin: 0;">Histórico de trabalho deste colaborador.</p>
                            </div>
                            <input type="date" id="modal-history-date-filter" onchange="refreshActiveHistories()" class="native-select" style="padding: 6px 10px; height: 35px; width: 140px;">
                        </div>
                        
                        <div id="m-historico-livre" style="max-height: 400px; overflow-y: auto; padding-right: 5px; text-align: left;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL PARA ATRIBUIR TAREFAS -->
    <div id="modal-assign-task" class="modal-overlay hidden" style="z-index: 5000;">
        <div class="modal-box" style="max-width: 450px;">
            <div style="padding: 25px;">
                <button class="close-btn" style="position: absolute; top: 15px; right: 15px;" onclick="fecharModalAssignTask()"><i class="ph ph-x"></i></button>
                <h3 style="margin-top: 0;"><i class="ph-bold ph-users-three"></i> Permissões da Tarefa</h3>
                <p style="font-size: 0.85rem; color: var(--muted); margin-bottom: 20px;">Quem poderá ver e usar a tarefa <b id="assign-task-name-display" style="color: var(--text);"></b>?</p>
                
                <div style="display: flex; flex-direction: column; gap: 15px;">
                    <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; background: rgba(0,0,0,0.05); padding: 12px; border-radius: 8px; border: 1px solid var(--border);">
                        <input type="radio" name="task_scope" value="all" checked onchange="toggleTaskScope()" style="width: auto; margin: 0; accent-color: var(--accent);">
                        <span style="font-weight: 600; font-size: 0.9rem;">🌍 Toda a Equipe</span>
                    </label>
                    
                    <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; background: rgba(0,0,0,0.05); padding: 12px; border-radius: 8px; border: 1px solid var(--border);">
                        <input type="radio" name="task_scope" value="specific" onchange="toggleTaskScope()" style="width: auto; margin: 0; accent-color: var(--accent);">
                        <span style="font-weight: 600; font-size: 0.9rem;">👤 Membros Específicos</span>
                    </label>
                </div>

                <div id="specific-scope-container" class="hidden" style="margin-top: 20px; border-top: 1px solid var(--border); padding-top: 15px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        <h4 style="font-size: 0.8rem; color: var(--muted); text-transform: uppercase; margin: 0;">Lista de Membros</h4>
                        <span id="count-selected-members" style="font-size: 0.75rem; background: var(--accent); color: var(--bg); padding: 2px 8px; border-radius: 12px; font-weight: bold;">0</span>
                    </div>
                    <div id="assign-users-list" style="max-height: 250px; overflow-y: auto; padding-right: 5px; display: flex; flex-direction: column; gap: 8px;"></div>
                </div>

                <button class="primary" style="width: 100%; margin-top: 25px;" onclick="confirmarNovaTarefa()">
                    <i class="ph-bold ph-check"></i> Salvar Tarefa
                </button>
            </div>
        </div>
    </div>

    <!-- Modal de Login -->
    <div id="modal-select-user" class="modal-overlay hidden" style="z-index: 4000;">
        <div class="modal-box" style="max-width: 400px; text-align: center; padding: 40px 30px;">
            <button class="close-btn" style="position: absolute; top: 15px; right: 15px;" onclick="fecharModalSelectUser()"><i class="ph ph-x"></i></button>
            <div style="background: rgba(56, 189, 248, 0.1); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto;">
                <i class="ph-fill ph-user-focus" style="font-size: 3rem; color: var(--accent);"></i>
            </div>
            <h2 style="margin: 0 0 10px 0; font-size: 1.5rem;">Acessar Sistema</h2>
            <div class="input-group" style="text-align: left;">
                <input type="text" id="input-search-user" placeholder="Digite seu nome..." onkeypress="if(event.key === 'Enter') confirmarSelectUser()" style="width: 100%; padding: 12px; border-radius: 8px; background: rgba(0,0,0,0.5); border: 1px solid var(--border); color: #fff; font-size: 1rem; margin-bottom: 15px; text-align: center;">
                <button class="primary" style="width: 100%;" onclick="confirmarSelectUser()">Buscar meu Perfil</button>
                <div style="text-align: center; margin-top: 25px; padding-top: 20px; border-top: 1px dashed rgba(255,255,255,0.1);">
                    <span style="font-size: 0.85rem; color: var(--muted); display: block; margin-bottom: 12px;">É novo por aqui?</span>
                    <button class="primary outline" style="width: 100%; border: 1px solid var(--accent); color: var(--accent); background: rgba(56, 189, 248, 0.05);" onclick="abrirCriarConta()">
                        <i class="ph-bold ph-plus" style="margin-right: 5px;"></i> Criar Minha Conta
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Criar Conta -->
    <div id="modal-create-account" class="modal-overlay hidden" style="z-index: 4100;">
        <div class="modal-box" style="max-width: 400px; text-align: center; padding: 40px 30px;">
            <button class="close-btn" style="position: absolute; top: 15px; right: 15px;" onclick="fecharCriarConta()"><i class="ph ph-x"></i></button>
            <h2 style="margin: 0 0 10px 0; font-size: 1.5rem;">Criar Minha Conta</h2>
            <div class="input-group" style="text-align: left;">
                <input type="text" id="new-self-user-name" placeholder="Ex: João da Silva" style="width: 100%; margin-bottom: 15px;">
                <select id="new-self-user-team" class="native-select" style="width: 100%; margin-bottom: 20px; padding: 12px;"></select>
                <button class="primary" style="width: 100%;" onclick="criarPropriaConta()">Criar e Acessar</button>
            </div>
        </div>
    </div>

    <!-- Modais de Perfil / Pin -->
    <div id="modal-user-profile" class="modal-overlay hidden" style="z-index: 4000;">
        <div class="modal-box" style="max-width: 350px; text-align: center; padding: 40px 30px;">
            <button class="close-btn" style="position: absolute; top: 15px; right: 15px;" onclick="fecharPerfilUsuario()"><i class="ph ph-x"></i></button>
            <img src="" id="profile-avatar" style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px auto;">
            <h2 id="profile-name" style="margin: 0 0 5px 0;">Nome</h2>
            <div style="display: flex; flex-direction: column; gap: 15px; margin-top:20px;">
                <button class="primary outline" onclick="alterarPin()">Alterar minha Senha</button>
                <button class="primary danger" onclick="deslogarUsuario()">Sair da Conta</button>
            </div>
        </div>
    </div>

    <div id="modal-create-pin" class="modal-overlay hidden" style="z-index: 4600;">
        <div class="modal-box" style="max-width: 400px; text-align: center; padding: 40px 30px;">
            <button class="close-btn" style="position: absolute; top: 15px; right: 15px;" onclick="fecharModalCreatePin()"><i class="ph ph-x"></i></button>
            <h2 style="margin: 0 0 10px 0; font-size: 1.5rem;" id="create-pin-title">Nova Senha</h2>
            <p id="create-pin-desc" style="color:var(--muted); font-size:0.9rem;">Crie um PIN de 4 números.</p>
            <input type="password" id="new-pin-input" placeholder="****" maxlength="4" onkeypress="if(event.key === 'Enter') salvarNovoPin()" style="text-align: center; font-size: 1.5rem; letter-spacing: 10px;">
            <button class="primary" style="width: 100%; margin-top: 20px;" onclick="salvarNovoPin()">Salvar PIN</button>
        </div>
    </div>

    <div id="modal-user-pin" class="modal-overlay hidden" style="z-index: 4500;">
        <div class="modal-box" style="max-width: 400px; text-align: center; padding: 40px 30px;">
            <button class="close-btn" style="position: absolute; top: 15px; right: 15px;" onclick="fecharModalPin()"><i class="ph ph-x"></i></button>
            <h2 id="pin-modal-title" style="margin: 0 0 10px 0; font-size: 1.5rem;">Entrar</h2>
            <input type="password" id="user-pin-input" placeholder="****" maxlength="4" onkeypress="if(event.key === 'Enter') verificarPinUsuario()" style="text-align: center; font-size: 1.5rem; letter-spacing: 10px;">
            <button class="primary" style="width: 100%; margin-top: 20px;" onclick="verificarPinUsuario()">Entrar</button>
        </div>
    </div>

    <div id="modal-confirm" class="modal-overlay hidden" style="z-index: 5000;">
        <div class="modal-box" style="max-width: 400px; text-align: center; padding: 40px 30px;">
            <h2 id="confirm-title" style="margin: 0 0 10px 0;">Atenção</h2>
            <p id="confirm-message" style="color: var(--muted); margin-bottom: 30px;"></p>
            <div style="display: flex; gap: 15px;">
                <button class="primary outline" onclick="fecharConfirm()" style="flex: 1;">Cancelar</button>
                <button class="primary danger" id="btn-confirm-action" style="flex: 1;">Sim</button>
            </div>
        </div>
    </div>

    <div id="modal-add-team" class="modal-overlay hidden">
        <div class="modal-box" style="max-width: 450px; padding: 30px;">
            <button class="close-btn" style="position: absolute; top: 15px; right: 15px;" onclick="fecharModalAddTeam()"><i class="ph ph-x"></i></button>
            <h2 style="margin-bottom: 20px; margin-top: 0;">Nova Equipe</h2>
            <input type="text" id="new-team-input" placeholder="Ex: Equipe de Vendas...">
            <button class="primary" style="width: 100%; margin-top: 20px;" onclick="confirmarAddTeam()">Criar Equipe</button>
        </div>
    </div>

    <!-- PAINEL ADMIN -->
    <div id="modal-admin" class="modal-overlay hidden">
        <div class="modal-box" style="max-width: 550px; background: var(--bg); border: 1px solid var(--border);">
            <div style="padding: 35px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 25px;">
                    <h2 style="margin:0;"><i class="ph-fill ph-gear" style="color: var(--accent);"></i> Ajustes Globais</h2>
                    <div style="display: flex; gap: 15px; align-items: center;">
                        <button class="close-btn" onclick="fecharAdmin()"><i class="ph ph-x"></i></button>
                    </div>
                </div>

                <div id="admin-greeting-box" style="border-left: 4px solid var(--accent); background: rgba(56, 189, 248, 0.1); padding: 12px 16px; border-radius: 8px; margin-bottom: 25px; font-size: 1.1rem; font-weight: 600; display: none;">
                    Olá, <span id="admin-logged-name" style="color: var(--accent); margin-left: 5px;">Admin</span>!
                </div>

                <details class="admin-panel-section" open>
                    <summary><h4><i class="ph-fill ph-broadcast" style="color: var(--success);"></i> Visão ao Vivo</h4></summary>
                    <div class="admin-panel-content">
                        <div id="admin-live-view" style="max-height: 250px; overflow-y: auto;"></div>
                        <button class="primary outline" style="width: 100%; margin-top: 15px;" onclick="carregarVisaoAoVivo()">Atualizar</button>
                    </div>
                </details>

                <details class="admin-panel-section">
                    <summary><h4><i class="ph-fill ph-folders" style="color: #f59e0b;"></i> Categorias</h4></summary>
                    <div class="admin-panel-content">
                        <div style="display: flex; gap: 10px;">
                            <input type="text" id="new-atividade-name" placeholder="Ex: classificação...">
                            <button class="primary" style="background: #f59e0b;" onclick="addAtividade()"><i class="ph-bold ph-plus"></i></button>
                        </div>
                        <div id="admin-atividades-list" style="margin-top: 15px; max-height: 200px; overflow-y: auto;"></div>
                    </div>
                </details>

                <details class="admin-panel-section">
                    <summary><h4><i class="ph-fill ph-list-dashes" style="color: #38bdf8;"></i> Tarefas</h4></summary>
                    <div class="admin-panel-content">
                        <div style="display: flex; gap: 10px;">
                            <input type="text" id="new-tarefa-name" placeholder="Ex: Daily, Triagem, Reuniões..." style="flex: 1;" onkeypress="if(event.key === 'Enter') abrirModalNovaTarefa()">
                            <button class="primary" style="background: #38bdf8; padding: 0 20px; width: auto;" onclick="abrirModalNovaTarefa()"><i class="ph-bold ph-plus"></i></button>
                        </div>
                        <div id="admin-tarefas-list" style="margin-top: 15px; max-height: 200px; overflow-y: auto;"></div>
                    </div>
                </details>

                <details class="admin-panel-section">
                    <summary><h4><i class="ph-fill ph-users" style="color: var(--success);"></i> Membros</h4></summary>
                    <div class="admin-panel-content">
                        <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                            <input type="text" id="new-user-name" placeholder="Nome completo...">
                            <button class="primary" style="background: var(--success);" onclick="addUser()"><i class="ph-bold ph-plus"></i></button>
                        </div>
                        <input type="text" id="admin-search-user" placeholder="Buscar membro..." oninput="filtrarListaAdminUsers()" style="margin-bottom: 15px;">
                        <div id="admin-users-list" style="max-height: 250px; overflow-y: auto;"></div>
                    </div>
                </details>

            </div>
        </div>
    </div>

    <div class="toast-container" id="toasts"></div>
   <script src="main.js"></script>
</body>
</html>
